# -*- coding: utf-8 -*-

################################################################################
## Глава 2. Крючок
################################################################################

label chapter2_hook:
    scene bg room_night
    with dissolve

    n "Телефон коротко вибрирует."
    n "Один раз."
    n "Но этого хватает, чтобы сон отступил."

    n "На экране новое назначение:"
    n "«Зона сортировки. Явка — 20:00. Подтвердить смену»."

    if ps_newbie_trust >= 2:
        n "Под уведомлением висит ещё одно сообщение."
        newb "Привет… Это я, с первой смены."
        newb "Ты завтра будешь?"
        n "Три слова."
        n "Но в них больше тревоги, чем в системном уведомлении."

    menu:
        "Подтвердить смену сразу":
            $ ps_efficiency += 2
            $ ps_key_choices = ps_key_choices + ["Ты подтвердил вторую смену без колебаний."]
            n "Палец нажимает кнопку раньше, чем ты успеваешь передумать."
            n "Система отвечает зелёной галочкой."
            n "Будто между вами только что состоялась сделка."

        "Отложить телефон и дать себе ещё десять минут":
            $ ps_endurance += 2
            $ ps_key_choices = ps_key_choices + ["Ты отвоевал у системы десять минут тишины."]
            n "Ты переворачиваешь телефон экраном вниз."
            n "Смена никуда не денется."
            n "Но эти десять минут пока принадлежат тебе."

        "Ответить новичку" if ps_newbie_trust >= 2:
            $ ps_humanity += 2
            $ ps_newbie_trust += 1
            $ ps_key_choices = ps_key_choices + ["Перед второй сменой ты пообещал новичку быть рядом."]
            p "Буду."
            p "Если снова что-то зависнет — не стой одна."
            newb "Спасибо."
            n "Ответ приходит почти мгновенно."
            n "Похоже, она всё это время смотрела на экран."

    stop music fadeout 2.0

    scene black
    with fade

    n "Сон возвращается."
    n "Но теперь в нём уже есть фиолетовый свет."

    jump chapter3_second_shift


################################################################################
## Глава 3. Вторая смена
################################################################################

label chapter3_second_shift:
    $ ps_chapter = 3

    scene bg black
    with fade

    centered "Глава 3\nВторая смена"

    pause 1.2

    scene bg room_night
    with dissolve

    play music "audio/home_ambient.mp3" fadein 2.5 loop

    n "Вечер приходит слишком быстро."
    n "Будильник снова не орёт."
    n "Сегодня он даже не нужен."

    n "Ты просыпаешься за минуту до сигнала."
    n "Тело уже знает расписание."

    if ps_first_shift_path == "протянул руку":
        n "В памяти всплывают коробки на полу."
        n "И чужое тихое «спасибо»."
    else:
        n "В памяти всплывает момент, когда ты остался на месте."
        n "Ты до сих пор не уверен, спас ли себя или просто отвернулся."

    n "На экране телефона горит подтверждённая смена."
    n "Назад кнопки нет."

    scene bg stairwell
    with dissolve

    n "Дверь закрывается."

    if renpy.loadable("audio/door_closed.mp3"):
        play sound "audio/door_closed.mp3"

    n "Вчера это был путь в неизвестность."
    n "Сегодня — маршрут."
    n "И это пугает сильнее."

    scene bg street_night
    with fade

    stop music fadeout 2.0
    play music "audio/night_walk.mp3" fadein 2.0 loop

    n "Город движется в другую сторону."
    n "Кто-то возвращается домой."
    n "Ты идёшь на склад."

    scene bg warehouse_outside
    with fade

    stop music fadeout 2.0
    play music "audio/night_shift.mp3" fadein 2.5 loop

    n "Фиолетовая линия на крыше встречает тебя без эмоций."
    n "Но сегодня ты уже знаешь, где вход."
    n "Где раздевалка."
    n "И где начинается поток."

    show vet neutral at ps_left
    with dissolve

    vet "Вернулся."

    p "Похоже на то."

    vet "После первой смены возвращаются не все."
    vet "После второй обычно уже не считают."

    show mem grin at ps_center
    with dissolve

    mem "А я считаю."
    mem "Сегодня у нас юбилей."
    mem "Два дня без побега."

    if ps_humor >= 3:
        p "Подожди поздравлять. Я ещё ворота вижу."
        mem "Вот."
        mem "Уже местный."
    else:
        n "Ты улыбаешься чуть увереннее, чем вчера."

    show newb tired at ps_right
    with dissolve

    n "Новичок стоит у турникета."
    n "Сегодня она выглядит не испуганной."
    n "Просто невыспавшейся."

    if ps_newbie_trust >= 2:
        newb "Ты пришёл."
        p "Я же написал."
        n "Она кивает."
        n "Плечи опускаются на пару сантиметров."
    else:
        newb "Привет."
        p "Привет."
        n "Между вами остаётся расстояние в одну вчерашнюю смену."

    hide vet
    hide mem
    hide newb
    with dissolve

    scene bg locker_room
    with fade

    n "В раздевалке громче, чем вчера."
    n "Сегодня ты слышишь не общий шум."
    n "Ты уже различаешь отдельные голоса."

    show sv neutral at ps_right
    with dissolve

    sv "Слушаем."
    sv "На сортировке хвост."
    sv "Тридцать тысяч единиц сверху плана."
    sv "Часть людей перекинули туда."

    mem "Слово «перекинули» всегда звучит так, будто мы коробки."

    sv "Сегодня без обучения."
    sv "Кто вчера понял — работает."
    sv "Кто не понял — понимает по ходу."

    n "Его взгляд на секунду задерживается на тебе."

    if ps_supervisor_respect >= 2:
        sv "Ты вчера спрашивал, если не понимал."
        sv "Продолжай."
    elif ps_supervisor_respect < 0:
        sv "И без историй про глючный ТСД."
    else:
        sv "Вопросы — до запуска линии."

    hide sv
    with dissolve

    n "Новичок поправляет перчатки."
    n "Слишком тщательно."

    menu:
        "Предложить работать рядом":
            $ ps_humanity += 2
            $ ps_newbie_trust += 2
            p "Давай встанем рядом."
            p "Если что — хотя бы увидим, где кто сломался."
            newb "Давай."
            mem "Командный режим разблокирован."

        "Сказать, что каждый отвечает за свой ТСД":
            $ ps_efficiency += 2
            p "Главное — следи за своим экраном."
            p "Тут каждый вытягивает свой участок."
            newb "Поняла."
            n "Она отвечает быстро."
            n "Будто закрывает тему раньше, чем станет неприятно."

        "Снять напряжение шуткой":
            $ ps_humor += 2
            $ ps_newbie_trust += 1
            p "Если что — делаем умное лицо."
            p "Система боится уверенных."
            newb "Это точно работает?"
            mem "Нет."
            mem "Но выглядит профессионально."

    jump chapter3_sorting_start


label chapter3_sorting_start:
    scene bg warehouse_inside
    with fade

    stop music fadeout 2.0
    play music "audio/warehouse_chill.mp3" fadein 2.5 loop

    show vet neutral at ps_left
    show mem grin at ps_center
    show newb worried at ps_right
    with dissolve

    n "Сортировка встречает тебя другим ритмом."
    n "Здесь коробки не едут."
    n "Они появляются."
    n "Сразу много."

    vet "Не смотри на весь объём."
    vet "Смотри на следующую вещь."

    mem "Психологическая хитрость."
    mem "Если не смотреть на катастрофу целиком, она становится набором мелких проблем."

    n "Ты берёшь первый товар."

    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"

    n "Пиип."
    n "Ячейка."
    n "Следующий."

    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"

    n "Пиип."

    n "На третьем скане экран краснеет."

    call screen ps_tsd_alert(
        "E-17",
        "ЯЧЕЙКА НЕ НАЙДЕНА",
        "Товар остаётся в активной задаче. Требуется ручная привязка."
    )

    n "Вчера такая надпись остановила бы тебя."
    n "Сегодня ты хотя бы знаешь, что паника не помогает."

    menu:
        "Позвать супервайзера и сразу показать ошибку":
            jump chapter3_error_supervisor

        "Попросить ветерана объяснить":
            jump chapter3_error_veteran

        "Попробовать решить самому":
            jump chapter3_error_self


label chapter3_error_supervisor:
    $ ps_supervisor_respect += 2
    $ ps_efficiency += 1

    p "Ошибка E-17. Ячейки нет."

    show sv neutral at ps_righter
    with dissolve

    sv "Хорошо, что не подтвердил вслепую."
    sv "Отводишь в проблемный поток."
    sv "Красная зона справа."

    if ps_supervisor_respect >= 3:
        sv "Вчерашнее запомнил."
    else:
        sv "Один раз показываю."

    n "На этот раз его движения не кажутся магией."
    n "Ты успеваешь увидеть последовательность."

    hide sv
    with dissolve

    jump chapter3_error_resolved


label chapter3_error_veteran:
    $ ps_humanity += 1
    $ ps_endurance += 1

    p "Покажешь, куда это?"

    vet "Покажу."
    vet "Только запомни не кнопку."
    vet "Запомни, почему туда."

    n "Он объясняет спокойно."
    n "Не быстрее, чем ты способен понять."

    mem "Осторожно."
    mem "На территории склада замечено обучение."

    jump chapter3_error_resolved


label chapter3_error_self:
    $ ps_efficiency += 2
    $ ps_endurance -= 1

    n "Ты открываешь меню."
    n "Назад."
    n "Ещё раз."
    n "Проблемный поток."

    if ps_efficiency >= 4:
        n "Получилось."
        n "Не с первого нажатия."
        n "Но без чужих рук."
        mem "Самостоятельность."
        mem "Опасный симптом. Скоро дадут больше работы."
    else:
        n "Экран снова моргает красным."
        vet "Не воюй с ТСД."
        vet "Он всё равно не почувствует вины."
        n "Ветеран показывает нужный пункт."

    jump chapter3_error_resolved


label chapter3_error_resolved:
    n "Проблемная коробка уходит в красную зону."
    n "Поток возвращается."

    n "Пять минут."
    n "Десять."
    n "Счёт времени снова ломается."

    hide vet
    hide mem
    hide newb
    with dissolve

    n "На табло горит отставание."
    n "Сначала минус восемь процентов."
    n "Потом минус одиннадцать."

    show sv neutral at ps_right
    with dissolve

    sv "Внимание."
    sv "Линия просела."
    sv "До перерыва возвращаем темп."

    n "Никто не отвечает."
    n "Но все начинают двигаться быстрее."

    sv "Ты."
    sv "Сектор рядом с новичком тоже забираешь."

    menu:
        "Спросить, почему нагрузку не разделят на всех":
            $ ps_humanity += 2
            $ ps_supervisor_respect += 1
            p "Почему только на двоих?"
            p "Если хвост общий — давайте раскидаем на линию."
            sv "Потому что там уже распределено."
            sv "Но вопрос правильный."
            sv "Дам вам ещё одного человека после запуска."

        "Молча взять дополнительный сектор":
            $ ps_efficiency += 3
            $ ps_endurance -= 1
            p "Понял."
            sv "Вот и хорошо."
            n "На экране появляется ещё одна очередь."
            n "Цифры растут быстрее, чем ты успеваешь их читать."

        "Ответить шуткой":
            $ ps_humor += 2
            p "А премиальный сектор будет?"
            sv "Будет."
            sv "В следующей жизни."
            mem "Подтверждаю."
            mem "Там же нормальный ТСД и оплачиваемый перерыв."

    hide sv
    with dissolve

    jump chapter3_pressure


label chapter3_pressure:
    show newb tired at ps_right
    with dissolve

    n "Дополнительный сектор начинает мигать."
    n "Одна задача."
    n "Три."
    n "Семь."

    if ps_newbie_trust >= 3:
        newb "Я не успеваю."
        newb "Я сейчас опять всё перепутаю."
    else:
        n "Новичок ничего не говорит."
        n "Но её движения становятся рваными."

    menu:
        "Забрать часть её задач":
            $ ps_humanity += 2
            $ ps_newbie_trust += 2
            $ ps_endurance -= 1
            p "Скидывай половину на меня."
            newb "Но у тебя и так два сектора."
            p "Разберёмся."
            n "Твой экран становится краснее."
            n "Зато её руки перестают дрожать."

        "Научить её работать с проблемным потоком":
            $ ps_humanity += 1
            $ ps_efficiency += 1
            $ ps_newbie_trust += 1
            p "Не пытайся закрыть всё."
            p "Ошибку сразу вправо. Обычное — в ячейку."
            p "Сначала чистим простое."
            newb "Хорошо."
            n "Через минуту её очередь впервые уменьшается."

        "Сказать держать темп самостоятельно":
            $ ps_efficiency += 2
            $ ps_newbie_trust -= 1
            p "Не смотри на общее число."
            p "Просто работай дальше."
            newb "Ладно."
            n "Она кивает."
            n "Но легче ей не становится."

    n "Табло показывает минус шесть процентов."
    n "Линия понемногу догоняет план."

    n "И именно тогда раздаётся металлический скрежет."

    jump chapter3_incident


################################################################################
## Центральный конфликт второй смены
################################################################################

label chapter3_incident:
    hide newb
    with dissolve

    n "Контейнер у края линии накренился."
    n "Его заполнили выше отметки."
    n "Одна коробка держит другую."
    n "Вся конструкция выглядит как обещание, которое скоро нарушат."

    show vet neutral at ps_left
    with dissolve

    vet "Стой."
    vet "Его нельзя дальше грузить."

    show sv neutral at ps_right
    with dissolve

    sv "До смены контейнера две минуты."
    sv "Не останавливаемся."

    vet "Он не выдержит две минуты."

    sv "У нас отставание."

    show mem grin at ps_center
    with dissolve

    mem "Отлично."
    mem "Физика против показателей."
    mem "Ставки принимаются до падения."

    n "Новичок тянется к следующей коробке."
    n "Она смотрит на тебя."
    n "Не на супервайзера."
    n "На тебя."

    call screen ps_tsd_alert(
        "STOP-04",
        "КОНТЕЙНЕР ПЕРЕПОЛНЕН",
        "Продолжение операции может привести к падению груза."
    )

    menu:
        "Нажать аварийную остановку":
            jump chapter3_incident_stop

        "Не останавливать линию, но быстро собрать людей":
            jump chapter3_incident_team

        "Выполнить указание и продолжить работу":
            jump chapter3_incident_norm


label chapter3_incident_stop:
    $ ps_second_shift_path = "остановил линию"
    $ ps_humanity += 3
    $ ps_endurance += 1
    $ ps_key_choices = ps_key_choices + ["Ты остановил линию из-за опасного контейнера."]

    n "Ты нажимаешь кнопку."

    stop music fadeout 0.3

    n "Гул обрывается."
    n "Тишина ударяет сильнее любой сирены."

    sv "Ты что сделал?"

    p "Контейнер падает."

    n "Секунда."
    n "Металлическая стенка прогибается."

    if renpy.loadable("audio/door_closed.mp3"):
        play sound "audio/door_closed.mp3"

    n "Верхняя коробка срывается."
    n "И падает ровно туда, где секунду назад стояла новичок."

    newb "..."

    vet "Вот поэтому."

    if ps_supervisor_respect >= 2:
        sv "Ладно."
        sv "Остановка обоснована."
        sv "Перегружаем и запускаемся."
        $ ps_supervisor_respect += 2
    else:
        sv "В следующий раз сначала кричишь."
        sv "Но кнопку нажал правильно."
        $ ps_supervisor_respect += 1

    play music "audio/warehouse_chill.mp3" fadein 1.5 loop

    jump chapter3_after_incident


label chapter3_incident_team:
    $ ps_second_shift_path = "собрал команду"
    $ ps_humanity += 2
    $ ps_efficiency += 1
    $ ps_newbie_trust += 1
    $ ps_key_choices = ps_key_choices + ["Ты собрал людей и разгрузил опасный контейнер."]

    p "Не грузим."
    p "Ветеран — держи стенку."
    p "Я снимаю верх."
    p "Новичок — отводи коробки."

    mem "А я?"

    p "Ты тоже работаешь."

    mem "Вот теперь ситуация действительно аварийная."

    n "Вы двигаетесь быстро."
    n "Без команды сверху."
    n "Без красивых слов."

    n "Контейнер скрипит."
    n "Но вес уходит раньше, чем металл сдаётся."

    sv "..."
    sv "Ладно."
    sv "Сработали."

    if ps_efficiency >= 5:
        sv "И линию почти не потеряли."
        $ ps_supervisor_respect += 2
    else:
        sv "Теперь возвращаем темп."
        $ ps_supervisor_respect += 1

    jump chapter3_after_incident


label chapter3_incident_norm:
    $ ps_second_shift_path = "выбрал цифры"
    $ ps_efficiency += 3
    $ ps_humanity -= 2
    $ ps_newbie_trust -= 2
    $ ps_key_choices = ps_key_choices + ["Ты продолжил работу, несмотря на опасный контейнер."]

    n "Ты берёшь следующую коробку."
    n "Сканируешь."

    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"

    n "Пиип."

    n "Новичок повторяет за тобой."

    n "Контейнер выдерживает ещё один товар."
    n "Второй."
    n "На третьем стенка уходит вбок."

    if renpy.loadable("audio/door_closed.mp3"):
        play sound "audio/door_closed.mp3"

    n "Коробки падают на пол."
    n "Линия всё равно останавливается."
    n "Только теперь — не по вашему решению."

    sv "Все целы?"

    vet "Целы."
    vet "Пока."

    sv "Почему не остановили?"

    n "Вопрос зависает между вами."

    p "Ты сказал продолжать."

    sv "Я сказал не терять темп."
    sv "Думать я не запрещал."

    n "Новичок отводит взгляд."
    n "Красная цифра на табло растёт."

    $ ps_supervisor_respect -= 1

    jump chapter3_after_incident


label chapter3_after_incident:
    hide sv
    hide vet
    hide mem
    with dissolve

    n "Контейнер меняют."
    n "Линия снова запускается."

    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"

    n "Пиип."
    n "Как будто ничего не произошло."

    show newb tired at ps_right
    with dissolve

    if ps_second_shift_path == "остановил линию":
        newb "Если бы ты не нажал…"
        p "Но я нажал."
        newb "Да."
        newb "Спасибо."
    elif ps_second_shift_path == "собрал команду":
        newb "Я думала, сейчас все просто отойдут."
        p "Тогда бы оно упало."
        newb "Не контейнер."
        newb "Я про людей."
    else:
        newb "Я видела, что он падает."
        newb "Но продолжила."
        p "Я тоже."
        n "Она кивает."
        n "Не в знак согласия."
        n "Просто потому, что добавить нечего."

    hide newb
    with dissolve

    n "До конца смены остаётся час."
    n "Он проходит медленнее всей ночи."

    show vet neutral at ps_left
    with dissolve

    vet "Люди думают, что отсюда уходят из-за тяжёлых коробок."
    vet "Не поэтому."

    p "А почему?"

    vet "Потому что однажды перестают замечать."
    vet "Что устали."
    vet "Что рядом кто-то устал."
    vet "Что опасно."

    vet "Когда всё становится «нормально» — вот тогда и пора пугаться."

    hide vet
    with dissolve

    show sv neutral at ps_right
    with dissolve

    sv "После смены на минуту останься."

    n "Тон ровный."
    n "По нему невозможно понять, это благодарность или проблема."

    jump chapter3_supervisor_talk


label chapter3_supervisor_talk:
    scene bg locker_room
    with fade

    stop music fadeout 2.0
    play music "audio/after_shift_ambient.mp3" fadein 2.0 loop

    show sv neutral at ps_right
    with dissolve

    sv "Вторая смена."
    sv "Уже видно, как ты работаешь."

    if ps_supervisor_respect >= 4:
        sv "Ты не зависаешь."
        sv "И не ждёшь, пока проблему решит кто-то другой."
        sv "Такие нужны."
    elif ps_efficiency >= ps_humanity:
        sv "Темп у тебя есть."
        sv "Но склад — не только цифры."
        sv "Если рядом падает контейнер, норма его не поднимет."
    else:
        sv "Ты много смотришь по сторонам."
        sv "Это хорошо, пока твой сектор не остаётся без рук."

    sv "Поэтому вопрос."
    sv "Ты здесь кем хочешь стать?"

    menu:
        "Тем, с кем люди выдерживают смену":
            $ ps_humanity += 3
            $ ps_key_choices = ps_key_choices + ["Ты выбрал быть опорой для людей."]
            p "Тем, с кем люди выдерживают смену."
            sv "Красиво."
            sv "Теперь докажи это темпом."

        "Тем, кому можно доверить участок":
            $ ps_efficiency += 2
            $ ps_supervisor_respect += 2
            $ ps_key_choices = ps_key_choices + ["Ты решил расти и отвечать за участок."]
            p "Тем, кому можно доверить участок."
            sv "Конкретно."
            sv "Посмотрим на следующей смене."

        "Тем, кто вовремя поймёт, когда пора уйти":
            $ ps_endurance += 3
            $ ps_key_choices = ps_key_choices + ["Ты пообещал себе не потерять выход."]
            p "Тем, кто вовремя поймёт, когда пора уйти."
            sv "Честно."
            sv "Только обычно этот момент замечают поздно."

        "Тем, кто переживёт всё это с нормальной шуткой":
            $ ps_humor += 3
            $ ps_key_choices = ps_key_choices + ["Ты выбрал не отдавать смене свой голос."]
            p "Тем, кто хотя бы не даст всем окончательно сойти с ума."
            sv "Шутник уже занят."
            p "Будет конкуренция."
            sv "Иди переодевайся."

    hide sv
    with dissolve

    jump chapter3_shift_end


label chapter3_shift_end:
    n "Раздевалка постепенно пустеет."
    n "Сегодня ты двигаешься медленнее."
    n "Но уже не потерянно."

    show mem grin at ps_center
    with dissolve

    mem "Ну что."
    mem "Второй уровень пройден."

    p "А босс где?"

    mem "Босс — это график."
    mem "Его нельзя победить."
    mem "Только временно закрыть."

    show vet neutral at ps_left
    with dissolve

    vet "Завтра увидимся."

    if ps_second_shift_path == "выбрал цифры":
        vet "И подумай про контейнер."
        vet "Не чтобы винить себя."
        vet "Чтобы в следующий раз решить раньше."
    else:
        vet "Сегодня нормально сделал."
        vet "Только не думай, что теперь всегда обязан спасать всех."

    n "Это звучит почти как приглашение."
    n "И почти как предупреждение."

    hide vet
    hide mem
    with dissolve

    scene bg warehouse_outside
    with fade

    n "На улице холодно."
    n "Фиолетовая линия остаётся за спиной."

    n "После первой смены ты думал:"
    n "«Я уже привыкаю»."

    n "После второй мысль другая:"
    n "«Кажется, меня уже заметили»."

    call screen ps_shift_report(
        "Итоги второй смены",
        "Система увидела результат. Люди запомнили твой выбор."
    )

    jump chapter4_hook


################################################################################
## Крючок следующей главы
################################################################################

label chapter4_hook:
    scene bg street_night
    with fade

    stop music fadeout 2.0
    play music "audio/city_night.mp3" fadein 2.0 loop

    n "Телефон вибрирует у самого выхода."

    if ps_supervisor_respect >= 4:
        n "Сообщение от супервайзера:"
        sv "На следующей смене подойдёшь раньше."
        sv "Есть разговор про участок."
        n "Под сообщением — файл."
        n "«Чек-лист старшего линии»."
    elif ps_newbie_trust >= 4:
        n "Сообщение от новичка:"
        newb "Спасибо за сегодня."
        newb "Я, кажется, завтра снова выйду."
        n "Следом приходит ещё одно."
        newb "Только никому не говори, что мне уже не так страшно."
    elif ps_efficiency >= 7:
        n "Системное уведомление:"
        n "«Высокий показатель обработки. Вам доступна дополнительная смена»."
        n "Ниже большая фиолетовая кнопка."
        n "«Принять»."
    else:
        n "Номер неизвестен."
        n "Сообщение короткое:"
        n "«Ты видел, что сегодня было с контейнером?»"
        n "«Это не первый раз»."

    n "Ты останавливаешься под фонарём."
    n "Склад позади продолжает гудеть."

    n "Смена закончилась."
    n "История — нет."

    stop music fadeout 3.0

    scene black
    with fade

    centered "Продолжение следует\n\nТвой путь: [ps_route_name()]"

    pause 2.0

    return
