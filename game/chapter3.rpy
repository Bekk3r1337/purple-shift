# -*- coding: utf-8 -*-

################################################################################
## Глава 2. Крючок
################################################################################

label chapter2_hook:
    scene bg room_night
    with dissolve

    n "Телефон коротко вибрирует и вытаскивает тебя из сна. На экране новое назначение: «Зона сортировки. Явка - 20:00. Подтвердить смену»."

    if ps_newbie_trust >= 2:
        n "Под уведомлением висит ещё одно сообщение."
        newb "Привет… Это я, с первой смены. Ты завтра будешь?"
        n "Под сообщением появляется надпись «печатает…», пропадает и появляется снова."

    menu:
        "Подтвердить смену сразу":
            $ ps_efficiency += 2
            $ ps_key_choices = ps_key_choices + ["Ты подтвердил вторую смену без колебаний."]
            n "Палец нажимает кнопку раньше, чем ты успеваешь передумать. На экране появляется зелёная галочка: смена подтверждена."

        "Отложить телефон и дать себе ещё десять минут":
            $ ps_endurance += 2
            $ ps_key_choices = ps_key_choices + ["Ты отвоевал у системы десять минут тишины."]
            n "Ты ставишь таймер на десять минут и переворачиваешь телефон экраном вниз. Подтвердить успеешь после сигнала."

        "Ответить новичку" if ps_newbie_trust >= 2:
            $ ps_humanity += 2
            $ ps_newbie_trust += 1
            $ ps_key_choices = ps_key_choices + ["Перед второй сменой ты пообещал новичку быть рядом."]
            p "Буду. Если снова что-то зависнет - не стой одна."
            newb "Спасибо."
            n "Ответ приходит почти мгновенно. Похоже, она всё это время смотрела на экран."

    stop music fadeout 2.0

    scene black
    with fade

    n "Ты снова засыпаешь. Телефон остаётся лежать рядом, экраном вверх."

    jump chapter3_second_shift


################################################################################
## Глава 2. Вторая смена
################################################################################

label chapter3_second_shift:
    $ ps_chapter = 2
    $ ps_begin_day(2)

    scene bg black
    with fade

    call screen ps_day_card(
        2,
        "Вторая смена",
        "Дорогу до склада ты уже запомнил. Всё остальное придётся учить заново."
    )

    call ps_show_consequence_echo(2)

    scene bg room_night
    with dissolve

    $ ps_play_ost("before_shift", fadein=2.5)

    n "Вечер приходит слишком быстро. Ты просыпаешься за минуту до будильника и успеваешь выключить его до первого сигнала."

    if ps_first_shift_path == "протянул руку":
        n "Ты вспоминаешь коробки на полу и тихое «спасибо» Леры."
    else:
        n "Ты вспоминаешь, как Лера осталась поднимать коробки, а ты продолжил работать. Вчера на это не было времени. Сейчас - есть."

    n "На экране телефона по-прежнему горит: «Смена подтверждена»."

    call ps2_pre_shift(2)

    scene bg stairwell
    with dissolve

    n "Дверь закрывается."

    if renpy.loadable("audio/door_closed.mp3"):
        play sound "audio/door_closed.mp3"

    n "Вчера приходилось сверяться с картой. Сегодня ты сворачиваешь к остановке, даже не достав телефон."

    scene bg street_night
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("walk_to_shift", fadein=2.0)

    n "На остановке люди едут домой с пакетами и рюкзаками. Тебе нужен автобус в обратную сторону."

    scene bg warehouse_outside
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("ordinary_shift", fadein=2.5)

    n "Фиолетовая вывеска видна ещё из автобуса. На этот раз ты сразу идёшь к нужному входу и не ищешь раздевалку по указателям."

    show vet neutral at ps_left
    with dissolve

    vet "Вернулся."

    p "Похоже на то."

    vet "Значит, руки утром разогнулись. После первой смены уже хорошо."

    show mem grin at ps_center
    with dissolve

    mem "А я считаю. Сегодня у нас юбилей. Два дня без побега."

    if ps_humor >= 3:
        p "Подожди поздравлять. Я ещё ворота вижу."
        mem "Вот. Уже местный."
    else:
        n "Ты улыбаешься чуть увереннее, чем вчера."

    show newb tired at ps_right
    with dissolve

    n "Лера стоит у турникета с бумажным стаканом. Под глазами тени; пока охранник проверяет пропуск, она дважды зевает."

    if ps_newbie_trust >= 2:
        newb "Ты пришёл."
        p "Я же написал."
        n "Она кивает. Плечи опускаются на пару сантиметров."
    else:
        newb "Привет."
        p "Привет."
        n "После приветствия оба смотрят на турникет. Разговор на этом заканчивается."

    hide vet
    hide mem
    hide newb
    with dissolve

    call ps_team_names
    call ps_human_shift_scene(2)

    scene bg locker_room
    with fade

    n "В раздевалке громче, чем вчера, и теперь в общем гуле ты уже различаешь голоса."

    show sv neutral at ps_right
    with dissolve

    sv "Слушаем. На сортировке хвост - тридцать тысяч единиц сверх плана. Часть людей уже перекинули туда."

    mem "Слово «перекинули» всегда звучит так, будто мы коробки."

    sv "Сегодня без обучения. Кто вчера понял - работает. Кто не понял - понимает по ходу."

    n "Его взгляд на секунду задерживается на тебе."

    if ps_supervisor_respect >= 2:
        sv "Ты вчера спрашивал, если не понимал. Продолжай."
    elif ps_supervisor_respect < 0:
        sv "И без историй про глючный ТСД."
    else:
        sv "Вопросы - до запуска линии."

    hide sv
    with dissolve

    n "Лера поправляет одну перчатку, потом вторую и снова возвращается к первой."

    menu:
        "Предложить работать рядом":
            $ ps_humanity += 2
            $ ps_newbie_trust += 2
            p "Давай встанем рядом. Если ТСД снова зависнет, быстрее разберёмся."
            newb "Давай."
            mem "Командный режим разблокирован."

        "Сказать, что каждый отвечает за свой ТСД":
            $ ps_efficiency += 2
            p "Главное - следи за своим экраном. Тут каждый вытягивает свой участок."
            newb "Поняла."
            n "Она быстро кивает и начинает проверять заряд ТСД."

        "Снять напряжение шуткой":
            $ ps_humor += 2
            $ ps_newbie_trust += 1
            p "Если что - делаем умное лицо. Система боится уверенных."
            newb "Это точно работает?"
            mem "Нет."
            mem "Но выглядит профессионально."

    call ps_exploration_phase(2, 1)
    call ps_route_week_scene(2)
    call ps2_shift_event(2)
    call ps2_storm_echo(2)

    jump chapter3_sorting_start


label chapter3_sorting_start:
    scene bg warehouse_inside
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("cold_line", fadein=2.5)

    show vet neutral at ps_left
    show mem grin at ps_center
    show newb worried at ps_right
    with dissolve

    n "На сортировке коробки приходят партиями: сначала пусто, потом сразу двадцать штук."

    vet "Не смотри на весь объём. Смотри на следующую вещь."

    mem "Я тоже так делаю. Особенно когда открываю график на неделю."

    n "Ты берёшь первый товар."

    $ ps_play_sfx("scan_ok")

    n "Пиип."
    n "Ячейка. Следующий."

    $ ps_play_sfx("scan_ok")

    n "Пиип."

    n "На третьем скане экран краснеет."

    call screen ps_tsd_alert(
        "E-17",
        "ЯЧЕЙКА НЕ НАЙДЕНА",
        "Товар остаётся в активной задаче. Требуется ручная привязка."
    )

    n "Красный экран уже не парализует. Ты вспоминаешь, где вчера открывали меню ошибок."

    menu:
        "Позвать супервайзера и сразу показать ошибку":
            jump chapter3_error_supervisor

        "Попросить ветерана объяснить":
            jump chapter3_error_veteran

        "Попробовать решить самому":
            jump chapter3_error_self


label chapter3_error_supervisor:
    $ ps_supervisor_respect += 2
    $ ps_efficiency += 1

    p "Ошибка E-17. Ячейки нет."

    show sv neutral at ps_righter
    with dissolve

    sv "Хорошо, что не подтвердил вслепую. Отводишь в проблемный поток. Красная зона справа."

    if ps_supervisor_respect >= 3:
        sv "Вчерашнее запомнил."
    else:
        sv "Один раз показываю."

    n "На этот раз ты успеваешь проследить: открыть задачу, выбрать причину, отправить товар в красную зону."

    hide sv
    with dissolve

    jump chapter3_error_resolved


label chapter3_error_veteran:
    $ ps_humanity += 1
    $ ps_endurance += 1

    p "Покажешь, куда это?"

    vet "Покажу. Смотри, почему коробка уходит вправо. Кнопку потом сам найдёшь."

    n "Он не торопит и ждёт, пока ты сам повторишь все действия."

    mem "Осторожно. На территории склада замечено обучение."

    jump chapter3_error_resolved


label chapter3_error_self:
    $ ps_efficiency += 2
    $ ps_endurance -= 1

    n "Ты открываешь меню, ошибаешься пунктом, возвращаешься и находишь проблемный поток."

    if ps_efficiency >= 4:
        n "Получилось со второго нажатия и своими руками."
        mem "Самостоятельность. Опасный симптом. Скоро дадут больше работы."
    else:
        n "Экран снова моргает красным."
        vet "Не воюй с ТСД. Он всё равно не почувствует вины."
        n "Виктор показывает нужный пункт."

    jump chapter3_error_resolved


label chapter3_error_resolved:
    n "Ты ставишь проблемную коробку в красную зону и берёшь следующую."

    n "Через десять минут ты уже не помнишь, сколько коробок прошло через руки."

    hide vet
    hide mem
    hide newb
    with dissolve

    n "На табло горит отставание. Сначала минус восемь процентов. Потом минус одиннадцать."

    show sv neutral at ps_right
    with dissolve

    sv "Внимание. Линия просела. До перерыва возвращаем темп."

    n "В ответ только пищат сканеры. Люди на линии ускоряются."

    sv "Ты. Сектор рядом с новичком тоже забираешь."

    menu:
        "Спросить, почему нагрузку не разделят на всех":
            $ ps_humanity += 2
            $ ps_supervisor_respect += 1
            p "Почему только на двоих? Если хвост общий - давайте раскидаем на линию."
            sv "Потому что там уже распределено. Но вопрос правильный. Дам вам ещё одного человека после запуска."

        "Молча взять дополнительный сектор":
            $ ps_efficiency += 3
            $ ps_endurance -= 1
            p "Понял."
            sv "Вот и хорошо."
            n "На экране появляется ещё одна очередь. Цифры растут быстрее, чем ты успеваешь их читать."

        "Ответить шуткой":
            $ ps_humor += 2
            p "А премиальный сектор будет?"
            sv "Будет. В следующей жизни."
            mem "Подтверждаю. Там же нормальный ТСД и оплачиваемый перерыв."

    hide sv
    with dissolve

    jump chapter3_pressure


label chapter3_pressure:
    show newb tired at ps_right
    with dissolve

    n "Дополнительный сектор начинает мигать. Одна задача. Три. Семь."

    if ps_newbie_trust >= 3:
        newb "Я не успеваю. Я сейчас опять всё перепутаю."
    else:
        n "Лера ничего не говорит, но её движения становятся рваными."

    menu:
        "Забрать часть её задач":
            $ ps_humanity += 2
            $ ps_newbie_trust += 2
            $ ps_endurance -= 1
            p "Скидывай половину на меня."
            newb "Но у тебя и так два сектора."
            p "Разберёмся."
            n "На твоём экране прибавляется очередь. Лера делает глубокий вдох и снова берётся за работу."

        "Научить её работать с проблемным потоком":
            $ ps_humanity += 1
            $ ps_efficiency += 1
            $ ps_newbie_trust += 1
            p "Не пытайся закрыть всё. Ошибку сразу вправо. Обычное - в ячейку. Сначала чистим простое."
            newb "Хорошо."
            n "Через минуту её очередь впервые уменьшается."

        "Сказать держать темп самостоятельно":
            $ ps_efficiency += 2
            $ ps_newbie_trust -= 1
            p "Не смотри на общее число. Просто работай дальше."
            newb "Ладно."
            n "Она кивает, но дважды подряд кладёт товар не в ту ячейку и возвращает его обратно."

    n "Табло показывает минус шесть процентов. Линия понемногу догоняет план."

    n "Со стороны контейнера раздаётся металлический скрежет."

    jump chapter3_incident


################################################################################
## Центральный конфликт второй смены
################################################################################

label chapter3_incident:
    hide newb
    with dissolve

    n "Контейнер у края линии накренился: его забили выше отметки, и теперь верхние коробки держатся друг за друга только за счёт собственного веса."

    show vet neutral at ps_left
    with dissolve

    vet "Стой. Его больше нельзя грузить."

    show sv neutral at ps_right
    with dissolve

    sv "До смены контейнера две минуты. Не останавливаемся."

    vet "Он не выдержит две минуты."

    sv "У нас отставание."

    show mem grin at ps_center
    with dissolve

    mem "Отлично. Физика против показателей. Ставки принимаются до падения."

    n "Лера тянется к следующей коробке, но смотрит не на супервайзера - на тебя."

    call screen ps_tsd_alert(
        "STOP-04",
        "КОНТЕЙНЕР ПЕРЕПОЛНЕН",
        "Продолжение операции может привести к падению груза."
    )

    menu:
        "Нажать аварийную остановку":
            jump chapter3_incident_stop

        "Не останавливать линию, но быстро собрать людей":
            jump chapter3_incident_team

        "Выполнить указание и продолжить работу":
            jump chapter3_incident_norm


label chapter3_incident_stop:
    $ ps_second_shift_path = "остановил линию"
    $ ps_humanity += 3
    $ ps_endurance += 1
    $ ps_key_choices = ps_key_choices + ["Ты остановил линию из-за опасного контейнера."]

    n "Ты нажимаешь кнопку."

    stop music fadeout 0.3

    n "Гул обрывается. После нескольких часов рядом с лентой в ушах продолжает звенеть."

    sv "Ты что сделал?"

    p "Контейнер падает."

    n "Секунда."
    n "Металлическая стенка прогибается."

    if renpy.loadable("audio/door_closed.mp3"):
        play sound "audio/door_closed.mp3"

    n "Верхняя коробка срывается. И падает ровно туда, где секунду назад стояла новичок."

    newb "..."

    vet "Вот поэтому."

    if ps_supervisor_respect >= 2:
        sv "Ладно. Остановка обоснована. Перегружаем и запускаемся."
        $ ps_supervisor_respect += 2
    else:
        sv "В следующий раз сначала кричишь. Но кнопку нажал правильно."
        $ ps_supervisor_respect += 1

    $ ps_play_ost("cold_line", fadein=1.5)

    jump chapter3_after_incident


label chapter3_incident_team:
    $ ps_second_shift_path = "собрал команду"
    $ ps_humanity += 2
    $ ps_efficiency += 1
    $ ps_newbie_trust += 1
    $ ps_key_choices = ps_key_choices + ["Ты собрал людей и разгрузил опасный контейнер."]

    p "Не грузим. Виктор, держи стенку, я сниму верх. Лера, отводи коробки."

    mem "А я?"

    p "Ты тоже работаешь."

    mem "Вот теперь ситуация действительно аварийная."

    n "Вы разбираете верхний ряд без команды сверху. Пока стенка медленно выгибается наружу, половина коробок уже оказывается на полу."

    sv "Ладно. Сработали."

    if ps_efficiency >= 5:
        sv "И линию почти не потеряли."
        $ ps_supervisor_respect += 2
    else:
        sv "Теперь возвращаем темп."
        $ ps_supervisor_respect += 1

    jump chapter3_after_incident


label chapter3_incident_norm:
    $ ps_second_shift_path = "выбрал цифры"
    $ ps_efficiency += 3
    $ ps_humanity -= 2
    $ ps_newbie_trust -= 2
    $ ps_key_choices = ps_key_choices + ["Ты продолжил работу, несмотря на опасный контейнер."]

    n "Ты берёшь следующую коробку и сканируешь."

    $ ps_play_sfx("scan_ok")

    n "Пиип."

    n "Лера повторяет за тобой."

    n "Контейнер выдерживает ещё один товар. Второй. На третьем стенка уходит вбок."

    if renpy.loadable("audio/door_closed.mp3"):
        play sound "audio/door_closed.mp3"

    n "Коробки падают на пол и перекрывают проход. Линию всё равно приходится остановить."

    sv "Все целы?"

    vet "Целы. Пока."

    sv "Почему не остановили?"

    n "Макс опускает сканер. Лера смотрит в пол."

    p "Ты сказал продолжать."

    sv "Я сказал не терять темп. Думать я не запрещал."

    n "Лера отводит взгляд. Красная цифра на табло растёт."

    $ ps_supervisor_respect -= 1

    jump chapter3_after_incident


label chapter3_after_incident:
    hide sv
    hide vet
    hide mem
    with dissolve

    n "Контейнер меняют. Линия снова запускается."

    $ ps_play_sfx("scan_ok")

    n "Первый скан после запуска звучит особенно громко. Через минуту линия снова работает в обычном темпе."

    show newb tired at ps_right
    with dissolve

    if ps_second_shift_path == "остановил линию":
        newb "Если бы ты не нажал…"
        p "Но я нажал."
        newb "Да. Спасибо."
    elif ps_second_shift_path == "собрал команду":
        newb "Я думала, сейчас все просто отойдут."
        p "Тогда бы оно упало."
        newb "Не контейнер. Я про людей."
    else:
        newb "Я видела, что он падает. Но продолжила."
        p "Я тоже."
        n "Она кивает, потому что добавить нечего."

    hide newb
    with dissolve

    n "До конца смены остаётся час. Ты несколько раз смотришь на табло, но минуты там почти не меняются."

    show vet neutral at ps_left
    with dissolve

    vet "От коробок спина болит. К этому хотя бы готов."

    p "А почему?"

    vet "Хуже, когда привыкаешь ко всему подряд: к чужой ошибке, к боли, к контейнеру на боку. Потом уже поздно разбираться, где надо было остановиться."

    hide vet
    with dissolve

    show sv neutral at ps_right
    with dissolve

    sv "После смены на минуту останься."

    n "Он уже отворачивается, поэтому спросить, зачем, ты не успеваешь."

    jump chapter3_supervisor_talk


label chapter3_supervisor_talk:
    scene bg locker_room
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("after_shift", fadein=2.0)

    show sv neutral at ps_right
    with dissolve

    sv "Вторая смена. Уже видно, как ты работаешь."

    if ps_supervisor_respect >= 4:
        sv "Ты не зависаешь. И не ждёшь, пока проблему решит кто-то другой. Такие нужны."
    elif ps_efficiency >= ps_humanity:
        sv "Темп у тебя есть. Но склад - не только цифры. Если рядом падает контейнер, норма его не поднимет."
    else:
        sv "Ты много смотришь по сторонам. Это хорошо, пока твой сектор не остаётся без рук."

    sv "Поэтому вопрос. Ты здесь кем хочешь стать?"

    menu:
        "Хочу, чтобы рядом со мной не боялись просить помощи":
            $ ps_humanity += 3
            $ ps_key_choices = ps_key_choices + ["Ты выбрал быть опорой для людей."]
            p "Хочу, чтобы рядом со мной не боялись просить помощи."
            sv "Тогда следи, чтобы помощь не оставляла без рук твой сектор."

        "Хочу научиться отвечать за участок":
            $ ps_efficiency += 2
            $ ps_supervisor_respect += 2
            $ ps_key_choices = ps_key_choices + ["Ты решил расти и отвечать за участок."]
            p "Хочу научиться отвечать за участок."
            sv "Конкретно. Посмотрим на следующей смене."

        "Хочу заметить, если эта работа начнёт меня ломать":
            $ ps_endurance += 3
            $ ps_key_choices = ps_key_choices + ["Ты пообещал себе не потерять выход."]
            p "Хочу заметить, если эта работа начнёт меня ломать."
            sv "Тогда не ври себе про усталость. Это проще сказать, чем сделать."

        "Хочу хотя бы не разучиться шутить":
            $ ps_humor += 3
            $ ps_key_choices = ps_key_choices + ["Ты выбрал не отдавать смене свой голос."]
            p "Хочу хотя бы не разучиться шутить."
            sv "Макс уже занял эту должность."
            p "Будет конкуренция."
            sv "Иди переодевайся."

    hide sv
    with dissolve

    jump chapter3_shift_end


label chapter3_shift_end:
    n "Раздевалка постепенно пустеет. Сегодня ты двигаешься медленнее. Но уже не потерянно."

    show mem grin at ps_center
    with dissolve

    mem "Ну что. Второй уровень пройден."

    p "А босс где?"

    mem "Босс - это график. Его нельзя победить. Только временно закрыть."

    show vet neutral at ps_left
    with dissolve

    vet "Завтра увидимся."

    if ps_second_shift_path == "выбрал цифры":
        vet "И подумай про контейнер. Не чтобы винить себя. Чтобы в следующий раз решить раньше."
    else:
        vet "Сегодня нормально сделал. Только не думай, что теперь всегда обязан спасать всех."

    n "Виктор стягивает перчатку, морщится и разминает пальцы."

    hide vet
    hide mem
    with dissolve

    scene bg warehouse_outside
    with fade

    n "На улице холодно. Фиолетовая линия остаётся за спиной."

    n "Вчера твоего имени никто не знал. Сегодня Артём попросил остаться после смены, а Лера ждала у турникета."

    call ps2_after_shift(2)

    call screen ps_shift_report(
        "Итоги второго дня",
        "Вторая смена закончена. То, что ты сделал у контейнера, заметили все."
    )

    jump chapter4_hook


################################################################################
## Крючок третьего дня
################################################################################

label chapter4_hook:
    scene bg street_night
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("city_night", fadein=2.0)

    n "Телефон вибрирует у самого выхода."

    if ps_supervisor_respect >= 4:
        n "Сообщение от супервайзера:"
        sv "На следующей смене подойдёшь раньше. Есть разговор про участок."
        n "Под сообщением - файл. «Чек-лист старшего линии»."
    elif ps_newbie_trust >= 4:
        n "Сообщение от новичка:"
        newb "Спасибо за сегодня. Я, кажется, завтра снова выйду."
        n "Следом приходит ещё одно."
        newb "Только никому не говори, что мне уже не так страшно."
    elif ps_efficiency >= 7:
        n "Системное уведомление:"
        n "«Высокий показатель обработки. Вам доступна дополнительная смена». Ниже большая фиолетовая кнопка. «Принять»."
    else:
        n "Номер неизвестен. Сообщение короткое:"
        n "«Ты видел, что сегодня было с контейнером?» «Это не первый раз»."

    n "Ты останавливаешься под фонарём. Склад позади продолжает гудеть."

    n "Смена закончилась. До конца недели - пять дней."

    stop music fadeout 3.0

    scene black
    with fade

    jump chapter3_day_three
