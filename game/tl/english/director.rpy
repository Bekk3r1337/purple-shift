    # newb "Я хотела сказать спасибо."
    newb "I wanted to say thank you."

# game/director.rpy:1271
translate english ps_personal_scene_f06dbffb:

    # p "За что?"
    p "For what?"

# game/director.rpy:1272
translate english ps_personal_scene_c5a7299f:

