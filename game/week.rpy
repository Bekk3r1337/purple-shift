    n "Твоё имя падает с первого места."

    show newb relief at ps_right
    show vet concerned at ps_left
    show mem serious at ps_center
    with dissolve

    newb "Все вышли."
    vet "Правая линия пустая."
    mem "Потери:"
    mem "Одна премия."
    mem "Ноль человек."

    n "Супервайзер подходит к аварийной кнопке."

    show sv stern at ps_righter
    with dissolve

    sv "Остановка обоснована."
    sv "Я подтверждаю."

    n "Куратор что-то говорит в рацию."
    n "Супервайзер выключает её."

    sv "Потом."

    hide newb
    hide vet
    hide mem
    hide sv
    with dissolve

    scene bg loading_dock
    with fade

    n "Сотрудником месяца становится человек с другого участка."
    n "Ты никогда с ним не встречался."

    n "На следующей неделе у аварийной кнопки появляется новая табличка."
    n "«При угрозе безопасности остановить поток»."
    n "Кто-то маркером дописывает:"
    n "«Даже если до рейтинга три минуты»."

    n "Новичок остаётся."
    n "Не потому что перестала бояться."
    n "Потому что теперь знает: рядом кто-то тоже видит."

    $ ps_unlock_cg("team_dawn")
    scene cg team_dawn
    with fade

    n "Утро за воротами выглядит непривычно."
    n "Никто не торопится первым отвернуться."

    jump ending_common


label ending_voice:
    scene bg warehouse_alert
    with dissolve

    n "Команды повторяют от человека к человеку."
    n "Правую линию освобождают."
    n "Тяжёлый товар остаётся на месте."
    n "Никто не спорит с красным экраном."

    show mem serious at ps_left
    with dissolve

    mem "Левая чистая!"

    show newb relief at ps_right
    with dissolve

    newb "Все на месте!"

    show vet concerned at ps_center
    with dissolve

    vet "Теперь стоп!"

    n "Ты поднимаешь руку."
    n "Десятки чужих голосов повторяют:"
    n "«Стоп!»"

    stop music fadeout 0.5

    n "Конвейер замирает."
    n "Не из-за одной кнопки."
    n "Потому что вся смена одновременно решила услышать друг друга."

    scene bg break_room
    with fade

    play music "audio/after_shift_ambient.mp3" fadein 2.0 loop

    n "В рейтинге ты остаёшься третьим."
    n "На доске нет твоей фотографии."

    mem "И хорошо."
    mem "У тебя там лицо было бы слишком серьёзное."

    newb "А можно назвать тебя сотрудником недели?"

    p "Нельзя."
    p "Звучит как дополнительная обязанность."

    n "Смеются все."
    n "Даже ветеран."
    n "Даже супервайзер — уже в дверях."

    $ ps_unlock_cg("team_dawn")
    scene cg team_dawn
    with fade

    n "На рассвете вы впервые выходите не по одному."

    jump ending_common


label ending_leader:
    scene bg packing_zone
    with dissolve

    n "Левая линия принимает поток."
    n "Правую успевают отключить до перегрева."
    n "Буфер заполняется до последней ячейки."
    n "Но выдерживает."

    n "Когда связь возвращается, система обнаруживает, что склад не остановился."
    n "И что никто не пострадал."

    show sv stern at ps_left
    show cur at ps_right
    with dissolve

    cur "Кто принял схему?"

    sv "Он."

    cur "Рискованно."

    p "Рискованно было продолжать вслепую."
    p "Мы остановили опасное и сохранили рабочее."

    n "Куратор смотрит на итоговые цифры."
    n "Потом — на людей."

    cur "С завтрашнего дня — старший линии."

    p "С правом остановки."

    cur "Что?"

    p "Если я отвечаю за участок, я решаю, когда он опасен."

    n "Пауза длится дольше, чем хотелось бы."

    cur "С правом остановки."

    hide sv
    hide cur
    with dissolve

    scene bg loading_dock
    with fade

    n "Тебе выдают другой жилет."
    n "На нём больше карманов."
    n "И гораздо больше ответственности."

    vet "Не зазнавайся."
    mem "Зазнавайся."
    newb "Просто не забывай, как выглядел твой первый день."

    p "Не забуду."

    jump ending_common


label ending_employee:
    scene bg packing_zone
    with dissolve

    n "Ты держишь линию до последней секунды."
    n "Система возвращается."
    n "Часть товара уходит не в те ячейки."
    n "Но итоговый процент остаётся зелёным."

    show cur at ps_center
    with dissolve

    cur "Период закрыт."
    cur "Первое место."
    cur "Поздравляю."

    n "На большом экране появляется твоё имя."
    n "Фиолетовая рамка."
    n "Золотая надпись:"
    n "«СОТРУДНИК МЕСЯЦА»."

    n "Ты смотришь по сторонам."

    if not ps_veteran_safe:
        n "Ветеран стоит в дверях с забинтованной рукой."

    if ps_newbie_trust < 2:
        n "Новичок уже ушла переодеваться."
        n "Завтра её не будет в графике."
    else:
        n "Новичок смотрит на экран."
        n "Но не улыбается."

    n "Шутник молчит."
    n "Супервайзер жмёт тебе руку."

    cur "Хороший результат."

    p "Да."

    n "Опасное слово."
    n "Обычно его говорят, когда не хотят разбираться."

    scene bg room_night
    with fade

    n "Дома ты ставишь электронный сертификат на экран."
    n "Фиолетовый свет ложится на пустую комнату."

    n "Ты доказал, что выдержишь давление."
    n "Система получила сотрудника месяца."
    n "Остался вопрос:"
    n "кто из вас кого выбрал."

    jump ending_common


label ending_exit:
    scene bg loading_dock
    with fade

    stop music fadeout 1.5
    play music "audio/city_night.mp3" fadein 2.0 loop

    n "Дверь закрывается за спиной."
    n "Склад продолжает гудеть."
    n "Без тебя."

    n "Первые шаги даются тяжело."
    n "Не потому что хочется вернуться."
    n "Потому что семь дней учили тебя не останавливаться."

    n "Телефон вибрирует."

    if ps_newbie_trust >= 3:
        newb "Ты правда ушёл?"
        p "Да."
        newb "Я тоже думаю."
        p "Думай сама."
        p "Но не позволяй им решить за тебя."

    vet "Правильно сделал."
    vet "Если вышел сам — значит, выход ещё был."

    mem "Печенье всё-таки украл."
    mem "Оставить тебе?"

    p "Обязательно."

    n "Ты смеёшься прямо на улице."
    n "Не чтобы пережить смену."
    n "Просто потому, что смешно."

    n "Твоё имя исчезает из рейтинга."
    n "Через минуту строки сдвигаются."
    n "Будто тебя там никогда не было."

    n "Но в твоей истории остаются все семь дней."
    n "И восьмой."
    n "Первый, который снова принадлежит тебе."

    jump ending_common


label ending_silence:
    scene bg warehouse_alert
    with dissolve

    n "Ты выбираешь."
    n "Но неделя уже выбрала слишком многое за тебя."

    n "Команды тонут в шуме."
    n "Люди отходят по одному."
    n "Линия останавливается сама — после того, как защита наконец замечает перегрев."

    show sv stern at ps_right
    with dissolve

    sv "Все целы?"

    n "Тот же вопрос."
    n "Третья аварийная ситуация."
    n "Седьмой день."

    p "Целы."

    sv "Хорошо."

    n "Опасное слово."

    scene bg break_room
    with fade

    n "Рейтинг аннулируют из-за технического сбоя."
    n "Сотрудника месяца сегодня не называют."
    n "Куратор обещает вернуться к вопросу позже."

    n "Люди расходятся."
    n "Кто-то останется."
    n "Кто-то уйдёт."
    n "Ты пока не знаешь, к кому относишься."

    n "Иногда финал — не ответ."
    n "Иногда это момент, когда вопрос впервые становится достаточно громким."

    jump ending_common


label ending_common:
    stop music fadeout 2.0
    $ ps_stop_ambience()

    scene black
    with fade

    $ ps_final_ending = ps_ending_id()
    $ ps_unlock_ending(ps_final_ending)
    $ ps_unlock_achievement("seven_days")
    $ ps_evaluate_achievements()
    $ ps_finish_run()

    call screen ps_final_report(
        ps_ending_title(ps_final_ending),
        ps_ending_description(ps_final_ending)
    )

    call screen ps_ending_epilogue(ps_final_ending)

    centered "Фиолетовая Смена\n\nСемь дней спустя"

    pause 2.0

    n "Смена заканчивается."
    n "То, что ты выбрал, остаётся."

    scene bg break_room
    with fade

    show mem grin at ps_center
    with dissolve

    mem "Эй."
    mem "Ты уже можешь закрывать игру."
    mem "Но раз досидел до конца..."
    mem "Спасибо, что досмотрели серию до конца!"

    hide mem
    with dissolve

    if ps_storm_ready():
        call ps_storm_teaser

    return
