# -*- coding: utf-8 -*-

################################################################################
## Глава 3. День третий — Чужие цифры
################################################################################

label chapter3_day_three:
    $ ps_chapter = 3
    $ ps_begin_day(3)

    scene black
    with fade

    call screen ps_day_card(
        3,
        "Чужие цифры",
        "Рейтинг замечает скорость. Архив хранит то, что людям приказали забыть."
    )

    call ps_show_consequence_echo(3)

    scene bg warehouse_outside
    with dissolve

    play music "audio/night_walk.mp3" fadein 2.0 loop

    n "На третий день дорога перестаёт быть дорогой."
    n "Поворот."
    n "Переход."
    n "Серая дверь."
    n "Ты проходишь маршрут почти не глядя."

    n "И только у входа вспоминаешь сообщение."

    if ps_supervisor_respect >= 4:
        n "В телефоне всё ещё лежит файл «Чек-лист старшего линии»."
        n "Сорок семь пунктов."
        n "Ни одного — о том, что делать, когда люди боятся."
    elif ps_newbie_trust >= 4:
        n "Новичок уже отметилась в приложении."
        n "Рядом с её именем зелёная точка."
        n "Сегодня она пришла раньше тебя."
    elif ps_efficiency >= 7:
        n "Фиолетовая кнопка дополнительной смены всё ещё горит."
        n "Система заметила твой темп."
        n "Ты пока не уверен, заметила ли она тебя."
    else:
        n "Неизвестный номер больше не писал."
        n "Фраза «Это не первый раз» не исчезает из головы."

    scene bg locker_room
    with fade

    stop music fadeout 1.5
    play music "audio/after_shift_ambient.mp3" fadein 2.0 loop

    show mem grin at ps_left
    with dissolve

    mem "Третий день."
    mem "Поздравляю: теперь ты достаточно опытный, чтобы обучать тех, кто пришёл пять минут назад."

    p "А сам?"

    mem "Я слишком ценный специалист."
    mem "Меня берегут от ответственности."

    show vet neutral at ps_right
    with dissolve

    vet "Не слушай."
    vet "Его от ответственности уже ничего не спасёт."

    n "Ветеран смотрит на тебя внимательнее обычного."

    if ps_second_shift_path == "выбрал цифры":
        vet "Про контейнер думал?"
        p "Думал."
        vet "Хорошо."
        vet "Значит, не зря упал."
    else:
        vet "После вчерашнего тебя будут проверять."
        p "За то, что сделал правильно?"
        vet "Особенно за это."

    hide mem
    hide vet
    with dissolve

    show sv neutral at ps_center
    with dissolve

    sv "Перед запуском — минута внимания."
    sv "В конце недели закрывают месячный рейтинг."
    sv "Лучший показатель получит премию и отметку «Сотрудник месяца»."

    n "На стене загорается экран."
    n "Фамилии."
    n "Проценты."
    n "Зелёные и красные стрелки."

    sv "Скорость."
    sv "Ошибки."
    sv "Соблюдение операций."
    sv "Всё считается."

    mem "Кроме желания жить."

    sv "Оно в KPI не входит."

    n "Твоё имя появляется в нижней части списка."
    n "Напротив — пустое место."
    n "Система ещё решает, кто ты."

    if ps_efficiency >= 7:
        sv "У тебя хороший старт."
        sv "Не испорть."
    elif ps_humanity >= 7:
        sv "Ты часто отвлекаешься на чужие участки."
        sv "В рейтинге помощь не всегда видна."
    else:
        sv "Неделя покажет."

    hide sv
    with dissolve

    call ps_exploration_phase(3, 1)

    if persistent.ps_reduce_motion:
        scene bg mezzanine
    else:
        scene bg mezzanine at ps_camera_drift
    with fade

    stop music fadeout 1.5
    play music "audio/warehouse_chill.mp3" fadein 2.0 loop
    $ ps_set_ambience("warehouse")

    n "Линия запускается."
    n "Третий день начинается с обычного звука."

    if renpy.loadable("audio/scan_soft.ogg"):
        play sound "audio/scan_soft.ogg"

    n "Пиип."
    n "Система выдаёт контрольную серию."
    n "Шесть товаров."
    n "Тридцать секунд."
    n "Ошибка отнимает время."

    $ ps_sort_start()
    call screen ps_sort_challenge
    $ ps_sort_result = _return

    if ps_sort_result[0] == len(ps_sort_items) and ps_sort_result[1] == 0:
        $ ps_efficiency += 2
        $ ps_unlock_achievement("clean_sort")
        $ ps_key_choices = ps_key_choices + ["Ты прошёл контрольную серию ТСД без пересорта."]
        n "Последний товар уходит в правильный сектор."
        n "Шесть из шести."
        n "Экран на секунду становится зелёным."
    elif ps_sort_result[0] >= 4:
        $ ps_efficiency += 1
        n "Серия закрывается."
        n "Не идеально."
        n "Но очередь не успевает тебя догнать."
    else:
        $ ps_endurance += 1
        $ ps_burnout += 1
        n "Таймер обнуляется раньше последнего товара."
        n "ТСД возвращает остаток в очередь."
        n "Смена запомнила ошибки и не запомнила, как быстро ты пытался их исправить."

    n "После контрольной серии ТСД не возвращается к товару."
    n "На экране появляется запись вчерашнего инцидента."

    call screen ps_tsd_alert(
        "LOG-00",
        "ЗАПИСЬ ОБ ОСТАНОВКЕ НЕ НАЙДЕНА",
        "Событие STOP-04 отсутствует в журнале участка."
    )

    n "Ты обновляешь экран."
    n "Ничего."
    n "Переполненный контейнер был."
    n "Падение коробок было."
    n "А в системе — чистая смена без происшествий."

    show newb worried at ps_right
    with dissolve

    newb "Ты тоже это видишь?"

    p "Вижу."

    if ps_second_shift_path == "остановил линию":
        newb "Но ты нажимал кнопку."
        newb "Она должна была записаться."
    elif ps_second_shift_path == "собрал команду":
        newb "Мы все там были."
        newb "Почему написано, что ничего не случилось?"
    else:
        newb "Коробки упали."
        newb "Я их потом собирала."

    show vet neutral at ps_left
    with dissolve

    vet "Потому что происшествие портит цифры."
    vet "А если удалить запись — портится только память."

    p "Ты знал?"

    vet "Я видел такое."

    n "Телефон в кармане коротко вибрирует."
    n "Неизвестный номер:"
    n "«Открой архив операций. Смена 02:14. Пока его тоже не почистили»."

    menu:
        "Сфотографировать журнал и открыть архив":
            $ ps_third_day_path = "сохранил журнал"
            $ ps_evidence += 2
            $ ps_integrity += 2
            $ ps_key_choices = ps_key_choices + ["Ты сохранил исчезнувшую запись об опасном контейнере."]

            n "Ты делаешь снимок экрана."
            n "Потом ещё один."
            n "В архиве находится строка STOP-04."
            n "Время совпадает."
            n "Статус: «Удалено оператором участка»."

            newb "Теперь это хотя бы не исчезнет совсем."
            vet "Храни не только в телефоне."
            vet "Здесь пропадают вещи покрупнее файлов."

        "Сразу позвать супервайзера":
            $ ps_third_day_path = "потребовал объяснение"
            $ ps_integrity += 2
            $ ps_supervisor_respect += 1
            $ ps_evidence += 1
            $ ps_key_choices = ps_key_choices + ["Ты потребовал объяснить исчезновение записи."]

            p "Событие удалено."
            p "Кем и почему?"

            show sv neutral at ps_center
            with dissolve

            sv "Техническая корректировка."

            p "Контейнер тоже был технической корректировкой?"

            n "Супервайзер смотрит на ветерана."
            n "Потом на новичка."
            n "Потом снова на тебя."

            sv "Работайте."
            sv "После смены проверю."

            hide sv
            with dissolve

            vet "Теперь он знает, что ты заметил."
            p "Это плохо?"
            vet "Это по-разному."

        "Закрыть журнал и сосредоточиться на рейтинге":
            $ ps_third_day_path = "выбрал рейтинг"
            $ ps_efficiency += 3
            $ ps_integrity -= 2
            $ ps_burnout += 1
            $ ps_key_choices = ps_key_choices + ["Ты закрыл пропавшую запись ради места в рейтинге."]

            n "Ты закрываешь окно."
            n "На его месте появляется очередь товаров."
            n "Зелёная цифра растёт."

            newb "И всё?"

            p "У нас работа."

            n "Она медленно кивает."
            n "Ветеран ничего не говорит."
            n "Это молчание система тоже не записывает."

    hide newb
    hide vet
    with dissolve

    n "К середине смены рейтинг становится отдельным шумом."
    n "Кто-то обновляет таблицу каждые пять минут."
    n "Кто-то говорит, что ему всё равно, и обновляет каждые три."

    show mem grin at ps_left
    with dissolve

    mem "Ты уже на четырнадцатом месте."
    mem "Ещё немного — и твою фотографию повесят там, где никто не смотрит."

    menu:
        "Ускориться и войти в первую десятку":
            $ ps_efficiency += 2
            $ ps_endurance -= 1
            $ ps_burnout += 1

            p "Посмотрим, что эта таблица умеет."
            n "Ты сокращаешь паузы."
            n "Пропускаешь воду."
            n "К концу часа твоё имя поднимается на девятое место."
            mem "Поздравляю."
            mem "Теперь тебя официально можно эксплуатировать эффективнее."

        "Держать ровный темп и следить за людьми":
            $ ps_humanity += 2
            $ ps_team_unity += 1

            p "Пусть считает."
            p "Я лучше буду видеть, что происходит рядом."
            n "Ты не попадаешь в десятку."
            n "Зато дважды ловишь чужую ошибку до того, как она становится проблемой."

        "Объявить таблице личную войну шутками":
            $ ps_humor += 2
            $ ps_team_unity += 1

            p "Предлагаю новый показатель."
            p "Кто дольше всех смотрел на рейтинг и не заплакал."
            mem "Я снимаюсь."
            mem "У меня непереносимость управленческой аналитики."
            n "Люди рядом смеются."
            n "На несколько секунд таблица перестаёт быть главным экраном."

    hide mem
    with dissolve

    n "Под конец смены ТСД снова вибрирует."

    call screen ps_tsd_alert(
        "RATE-03",
        "РЕЙТИНГ ОБНОВЛЁН",
        "До закрытия периода осталось четыре дня."
    )

    n "Четыре дня."
    n "В первый ты пытался понять склад."
    n "Теперь склад пытается понять, насколько далеко тебя можно толкнуть."

    call screen ps_shift_report(
        "Итоги третьего дня",
        "Цифры запомнили скорость. Люди — то, что ты сделал с исчезнувшей записью."
    )

    $ ps_stop_ambience()
    jump chapter4_day_four


################################################################################
## Глава 4. День четвёртый — Чужая ошибка
################################################################################

label chapter4_day_four:
    $ ps_chapter = 4
    $ ps_begin_day(4)

    scene black
    with fade

    call screen ps_day_card(
        4,
        "Чужая ошибка",
        "Когда система не может признать сбой, она начинает искать человеческое имя."
    )

    call ps_show_consequence_echo(4)

    scene bg room_morning
    with dissolve

    play music "audio/home_ambient.mp3" fadein 2.0 loop

    n "Ты просыпаешься от сообщения."
    n "Не будильник."
    n "Новичок."

    newb "Меня вызывают раньше."
    newb "Пишут, что вчера на моём аккаунте недостача."
    newb "Сорок семь единиц."

    n "Сорок семь."
    n "То же число, которое мелькало в удалённом журнале."

    if ps_evidence >= 2:
        n "У тебя в телефоне лежит снимок архива."
        n "На нём — сбой привязки сразу после удаления STOP-04."
    else:
        n "Ты помнишь экран."
        n "Но память не прикрепишь к служебной записке."

    menu:
        "Ответить: «Ничего не подписывай без меня»":
            $ ps_humanity += 2
            $ ps_newbie_trust += 2
            $ ps_team_unity += 1
            p "Ничего не подписывай."
            p "Я скоро буду."
            newb "Хорошо."
            n "Одно слово."
            n "На этот раз оно звучит не испуганно, а собранно."

        "Попросить её прислать номер операции":
            $ ps_efficiency += 2
            $ ps_evidence += 1
            p "Пришли номер операции и время."
            p "Проверим цепочку."
            newb "Сейчас."
            n "Через минуту у тебя есть всё, кроме объяснения."

        "Посоветовать самой поговорить с супервайзером":
            $ ps_endurance += 1
            $ ps_newbie_trust -= 1
            $ ps_burnout += 1
            p "Поговори с супервайзером."
            p "Я не могу решать всё."
            newb "Да."
            newb "Конечно."
            n "Переписка заканчивается слишком быстро."

    scene bg locker_room
    with fade

    stop music fadeout 1.5
    play music "audio/after_shift_ambient.mp3" fadein 2.0 loop

    show newb worried at ps_left
    show sv neutral at ps_right
    with dissolve

    sv "Сорок семь единиц прошли под твоим аккаунтом."
    sv "Ячейка назначения пустая."

    newb "У меня завис ТСД."

    sv "У всех зависает."
    sv "Недостача почему-то одна."

    n "На столе лежит бланк."
    n "«Объяснительная»."
    n "Ниже уже напечатана фраза:"
    n "«Ошибка допущена по невнимательности сотрудника»."

    if ps_evidence >= 2:
        n "В твоём телефоне есть другая версия событий."

    menu:
        "Показать архив и защищать новичка":
            $ ps_fourth_day_path = "защитил новичка"
            $ ps_humanity += 3
            $ ps_integrity += 2
            $ ps_newbie_trust += 2
            $ ps_team_unity += 2
            $ ps_key_choices = ps_key_choices + ["Ты не позволил списать системную ошибку на новичка."]

            p "Вот номер операции."
            p "Она прошла сразу после того, как из журнала удалили STOP-04."

            if ps_evidence >= 2:
                p "И вот снимок архива."
                n "Супервайзер долго смотрит на экран."
                sv "Откуда это у тебя?"
                p "Из системы."
                sv "Я вижу."
                sv "Спрашиваю — зачем сохранил?"
                p "Потому что система уже один раз забыла."
                $ ps_supervisor_respect += 1
                $ ps_evidence += 1
            else:
                sv "Слов недостаточно."
                p "Тогда проверьте резервный журнал."
                n "Он молчит."
                n "Но бланк отодвигает."

            sv "Объяснительную пока не подписываем."
            sv "Я подниму операции."
            newb "Спасибо."

        "Молча восстановить цепочку операций":
            $ ps_fourth_day_path = "нашёл ошибку системы"
            $ ps_efficiency += 3
            $ ps_evidence += 2
            $ ps_integrity += 1
            $ ps_newbie_trust += 1
            $ ps_supervisor_respect += 1
            $ ps_key_choices = ps_key_choices + ["Ты восстановил цепочку и нашёл настоящую причину недостачи."]

            p "Дайте ТСД."
            n "Ты открываешь историю."
            n "Сверяешь время."
            n "Сорок семь товаров ушли в буферную ячейку."
            n "После ночной перезагрузки она перестала отображаться."

            p "Они не пропали."
            p "Система потеряла ссылку."

            sv "Уверен?"

            p "Откройте буфер B-04."

            n "Через минуту приходит подтверждение."
            n "Все сорок семь единиц на месте."

            sv "Хорошая работа."
            newb "То есть… я ничего не потеряла?"
            p "Нет."
            p "Только несколько лет жизни."

        "Не вмешиваться и сохранить место в рейтинге":
            $ ps_fourth_day_path = "оставил виноватой"
            $ ps_efficiency += 2
            $ ps_integrity -= 3
            $ ps_newbie_trust -= 3
            $ ps_team_unity -= 1
            $ ps_supervisor_respect += 1
            $ ps_key_choices = ps_key_choices + ["Ты позволил системе назначить виноватую."]

            n "Ты остаёшься у двери."
            n "Бланк шуршит."
            n "Новичок берёт ручку."

            newb "Мне написать, что я была невнимательна?"

            sv "Если не можешь объяснить иначе."

            n "Она смотрит на тебя."
            n "Ты отводишь взгляд к рейтингу на стене."
            n "Твоё имя поднялось ещё на одну строку."

    hide newb
    hide sv
    with dissolve

    call ps_exploration_phase(4, 1)

    scene bg warehouse_cold
    with fade

    stop music fadeout 1.5
    play music "audio/warehouse_chill.mp3" fadein 2.0 loop
    $ ps_set_ambience("warehouse")

    n "Четвёртая смена идёт холоднее предыдущих."
    n "Люди уже знают про сорок семь единиц."
    n "На складе новости движутся быстрее товара."

    n "Через два часа ТСД разрешает десятиминутный перерыв."
    n "Сегодня ты впервые сам выбираешь, с кем его провести."

    scene bg break_room
    with dissolve

    $ ps_set_ambience("quiet")

    call screen ps_break_choice
    $ ps_break_target = _return

    if ps_break_target == "newbie":
        $ ps_humanity += 1
        $ ps_newbie_trust += 2
        $ ps_team_unity += 1

        show newb relief at ps_enter_right
        with dissolve

        p "Как ты?"

        if ps_fourth_day_path == "оставил виноватой":
            newb "Уже нормально."
            n "Опасное слово."
            p "Прости, что не вмешался."
            newb "Я запомню."
            n "Это не прощение."
            n "Но хотя бы разговор."
        else:
            newb "Злюсь."
            p "Это лучше, чем бояться."
            newb "Гораздо."

        hide newb
        with dissolve

    elif ps_break_target == "veteran":
        $ ps_endurance += 1
        $ ps_evidence += 1

        show vet concerned at ps_enter_left
        with dissolve

        p "Что с подъёмником?"
        vet "Датчик перегруза врёт вторую неделю."
        vet "Заявку закрывают, потому что после перезапуска ошибка исчезает."
        p "А неисправность?"
        vet "Она читать отчёты не умеет."
        n "Ты сохраняешь номер старой заявки."

        hide vet
        with dissolve

    elif ps_break_target == "joker":
        $ ps_humor += 2
        $ ps_team_unity += 1

        show mem grin at ps_center
        with dissolve

        mem "У меня важный вопрос."
        mem "Если склад потерял сорок семь товаров, а потом нашёл — это инвентаризация или квест?"
        p "Зависит от награды."
        mem "Награда — ещё одна смена."
        p "Худший квест."
        n "Десять минут проходят быстрее."

        hide mem
        with dissolve

    else:
        $ ps_endurance += 2
        $ ps_burnout = max(0, ps_burnout - 1)

        n "Ты садишься у стены."
        n "Не открываешь рейтинг."
        n "Не проверяешь сообщения."
        n "Десять минут склад существует без твоего участия."
        n "И почему-то не рушится."

    scene bg warehouse_cold
    with dissolve

