            $ ps_signed_false_report = True
            $ ps_accepted_lead_role = True
            $ ps_efficiency += 3
            $ ps_supervisor_respect += 2
            $ ps_integrity -= 4
            $ ps_team_unity -= 1
            $ ps_key_choices = ps_key_choices + ["Ты подписал чистый отчёт ради должности старшего."]

            n "Ручка тяжёлая."
            n "Подпись получается ровной."

            cur "Разумный подход."
            cur "Старший должен видеть результат целиком, а не отдельные эмоции."

            sv "Завтра встанешь рядом со мной."
            sv "Будешь вести часть линии."

            n "Ты получил то, чего хотел."
            n "Осталось понять, когда именно ты успел этого захотеть."

        "Отказаться от роли и сохранить копии":
            $ ps_sixth_day_path = "сохранил правду"
            $ ps_signed_false_report = False
            $ ps_accepted_lead_role = False
            $ ps_integrity += 3
            $ ps_evidence += 2
            $ ps_endurance += 2
            $ ps_supervisor_respect -= 1
            $ ps_key_choices = ps_key_choices + ["Ты отказался от должности и сохранил копии документов."]

            p "Я это не подпишу."
            p "И старшим на таких условиях не буду."

            cur "Ты отказываешься от возможности роста?"

            p "Я отказываюсь называть это штатной работой."

            n "Ты фотографируешь листы."
            n "Куратор не запрещает."
            n "Только запоминает."

            cur "Тогда завтра ты выходишь как обычный сотрудник."

            p "Я им и был."

    hide sv
    hide cur
    with dissolve

    scene bg warehouse_inside
    with fade

    stop music fadeout 1.5
    play music "audio/warehouse_chill.mp3" fadein 2.0 loop

    show newb tired at ps_right
    with dissolve

    newb "Что они хотели?"

    if ps_signed_false_report:
        p "Предложили стать старшим."
        newb "И?"
        p "Я согласился."
        n "Она ждёт продолжения."
        n "Ты не говоришь про подпись."
        newb "Поздравляю."
        n "Звучит правильно."
        n "Только не радостно."
    elif ps_sixth_day_path == "исправил отчёт":
        p "Чтобы я подтвердил, что всё было нормально."
        newb "Но нормально не было."
        p "Я так и написал."
        $ ps_newbie_trust += 1
        $ ps_team_unity += 1
    else:
        p "Должность в обмен на подпись."
        newb "Ты отказался?"
        p "Да."
        newb "Страшно?"
        p "Очень."
        newb "Хорошо."
        p "Что именно?"
        newb "Что тебе ещё страшно."
        $ ps_newbie_trust += 2

    hide newb
    with dissolve

    if ps_veteran_safe:
        show vet neutral at ps_left
        with dissolve

        vet "Завтра будет тяжело."
        p "Почему?"
        vet "Потому что последний день."
        vet "В последний день люди либо держатся за то, кем были всю неделю."
        vet "Либо наконец делают выбор."

        hide vet
        with dissolve
    else:
        n "Телефон вибрирует."
        n "Сообщение от ветерана:"
        vet "Рука цела. Почти."
        vet "Завтра буду."
        vet "Кто-то же должен не дать вам угробить вторую."

    show mem grin at ps_center
    with dissolve

    mem "Я составил план на финал."

    p "Какой?"

    mem "Не умереть."
    mem "Не уволиться до перерыва."
    mem "И украсть печенье из комнаты куратора."

    p "Амбициозно."

    mem "Мы росли всю неделю."

    hide mem
    with dissolve

    n "Рейтинг обновляется в предпоследний раз."
    n "Завтра останется одна строка."
    n "Одно имя."

    call screen ps_shift_report(
        "Итоги шестого дня",
        "До финала осталась одна смена. Теперь система знает цену твоей подписи."
    )

    $ ps_stop_ambience()
    jump chapter7_day_seven


################################################################################
## Глава 7. День седьмой — Последняя смена
################################################################################

label chapter7_day_seven:
    $ ps_chapter = 7
    $ ps_begin_day(7)

    scene black
    with fade

    call screen ps_day_card(
        7,
        "Последняя смена",
        "До закрытия периода — шесть часов. До главного решения — одна смена."
    )

    call ps_show_consequence_echo(7)

    scene bg room_morning
    with dissolve

    play music "audio/home_ambient.mp3" fadein 2.0 loop

    n "На седьмой день будильник всё-таки орёт."
    n "Ты выключаешь его с первого движения."

    n "Неделю назад комната была местом, из которого ты уходил."
    n "Теперь она кажется берегом."
    n "Склад — чем-то, что ждёт за дверью."

    n "На телефоне четыре уведомления."

    if ps_newbie_trust >= 4:
        newb "Я уже еду."
        newb "Сегодня не потеряемся."
    else:
        newb "Буду на смене."

    if ps_veteran_safe:
        vet "Не опаздывай."
    else:
        vet "Рука в бинте. Но я приду."

    mem "Печенье отменяется."
    mem "Куратор унёс его с собой."

    if ps_signed_false_report:
        sv "Подойди к линии за двадцать минут. Старший выходит раньше."
    else:
        sv "Сегодня закрываем неделю. Нужны все."

    n "Последнее уведомление — системное."
    n "«Пиковая нагрузка. Ожидается превышение плана на 34%%»."

    menu:
        "Ответить всем: «Встретимся на линии»":
            $ ps_team_unity += 1
            $ ps_humanity += 1
            p "Встретимся на линии."
            n "Четыре разных человека получают одну и ту же фразу."
            n "Сегодня этого достаточно."

        "Открыть рейтинг перед выходом":
            $ ps_efficiency += 1
            $ ps_burnout += 1
            n "Твоё имя в первой части списка."
            n "Точное место скрыто до конца смены."
            n "Система оставляет интригу, будто это шоу."

        "Выключить телефон и посидеть минуту в тишине":
            $ ps_endurance += 2
            $ ps_burnout -= 1
            n "Шестьдесят секунд ты никому ничего не должен."
            n "Потом встаёшь."
            n "Это маленькая победа."

    scene bg street_night
    with fade

    stop music fadeout 1.5
    play music "audio/night_walk.mp3" fadein 2.0 loop

    n "Город провожает тебя знакомыми фонарями."
    n "Каждый поворот хранит одну из семи версий тебя."
    n "Ту, которая боялась."
    n "Ту, которая ускорялась."
    n "Ту, которая остановила линию."
    n "Ту, которая промолчала."

    scene bg warehouse_outside
    with fade

    n "Фиолетовая линия горит ярче обычного."
    n "Сегодня под ней поставили баннер:"
    n "«ЛЮДИ — НАШ ГЛАВНЫЙ РЕСУРС»."

    p "Ресурс."

    n "Слово звучит как предупреждение."

    scene bg locker_room
    with fade

    stop music fadeout 1.5
    play music "audio/after_shift_ambient.mp3" fadein 2.0 loop
    $ ps_set_ambience("quiet")

    show newb relief at ps_enter_right
    show mem grin at ps_center
    with dissolve

    newb "Ну что."
    newb "Последний день."

    mem "Не говори так."
    mem "В хоррорах после этой фразы всегда выключается свет."

    show vet neutral at ps_left
    with dissolve

    vet "Свет не выключится."
    vet "Здесь генератор."

    mem "Спасибо."
    mem "Теперь точно выключится."

    n "Ты смеёшься."
    n "Даже если не хотел."

    if ps_team_unity >= 5:
        n "Впервые вы стоите не случайной группой у шкафчиков."
        n "Вы — смена."
    else:
        n "Вы стоите рядом."
        n "Но между каждым остаётся собственная неделя."

    hide newb
    hide mem
    hide vet
    with dissolve

    show sv neutral at ps_center
    with dissolve

    sv "Сегодня без длинных вводных."
    sv "Объём видите."
    sv "До конца периода — шесть часов."

    if ps_accepted_lead_role:
        sv "Ты ведёшь правую линию."
        sv "Решения по мелким остановкам — твои."
        n "Он протягивает тебе второй ТСД."
        n "На экране слово: «СТАРШИЙ»."
    elif ps_supervisor_respect >= 4:
        sv "Если линия встанет — сначала докладываешь мне."
        sv "Но людей рядом слушай."
    else:
        sv "Работаем по операции."

    sv "Куратор вернётся к закрытию."
    sv "И объявит результат."

    hide sv
    with dissolve

    if persistent.ps_reduce_motion:
        scene bg packing_zone
    else:
        scene bg packing_zone at ps_camera_drift
    with fade

    stop music fadeout 1.5
    play music "audio/warehouse_chill.mp3" fadein 2.0 loop
    $ ps_set_ambience("warehouse")

    n "Первые два часа склад работает почти идеально."
    n "Поток идёт."
    n "Ячейки принимают."
    n "Табло зеленеет."

    if ps_efficiency >= 11:
        n "Ты видишь узкие места раньше, чем они возникают."
        n "Перебрасываешь людей."
        n "Чистишь хвост."
    elif ps_humanity >= 10:
        n "Ты замечаешь, когда у новичка сбивается дыхание."
        n "Когда ветеран меняет руку."
        n "Когда шутник перестаёт шутить."
    elif ps_endurance >= 10:
        n "Ты держишь ровный темп."
        n "Не позволяешь ни табло, ни крикам забрать весь воздух."
    else:
        n "Ты просто продолжаешь."
        n "Иногда это всё, что возможно."

    n "На третьем часу приходит дополнительная машина."
    n "Её не было в плане."
    n "Потом вторая."

    call screen ps_tsd_alert(
        "PEAK-34",
        "ВНЕПЛАНОВАЯ ПОСТАВКА",
        "Перенаправление невозможно. Все доступные линии назначены."
    )

    show sv stern at ps_left
    with dissolve

    sv "Не останавливаемся."
    sv "Закрываем всё до конца периода."

    show newb worried at ps_right
    with dissolve

    newb "У меня ячейки не принимают."

    show vet concerned at ps_center
    with dissolve

    vet "Правый конвейер греется."

    sv "Пять минут."
    sv "Нужно дотянуть пять минут."

    n "Эту фразу ты уже слышал."
    n "Тогда был контейнер."

    if renpy.loadable("audio/alarm_low.ogg"):
        play sound "audio/alarm_low.ogg"

    if persistent.ps_reduce_motion:
        scene bg warehouse_alert
        with dissolve
    else:
        scene bg warehouse_alert
        with hpunch

    $ ps_set_ambience("alert")

    n "Свет моргает."
    n "Раз."
    n "Два."
    n "Фиолетовые лампы остаются гореть, когда белые гаснут."

    stop music fadeout 0.5

    n "Конвейер не останавливается."
    n "ТСД один за другим уходят в красный экран."
    n "Табло продолжает считать, хотя люди больше не понимают, куда идёт товар."

    call screen ps_tsd_alert(
        "CORE-07",
        "СВЯЗЬ С СИСТЕМОЙ ПОТЕРЯНА",
        "Автономный поток активен. Ручная остановка доступна старшему линии."
    )

    play music "audio/night_shift.mp3" fadein 1.0 loop

    show mem serious at ps_center
    with dissolve

    mem "Ну."
    mem "Финальный босс всё-таки пришёл."

    n "У аварийной кнопки стоит супервайзер."
    n "В руке у него рация."

    cur "Линию не останавливать."
    n "Голос куратора хрипит из динамика."
    cur "До закрытия рейтинга три минуты."

    vet "Без системы товар уйдёт не туда."
    newb "Люди на правой линии не слышат команды."

    if ps_evidence >= 3:
        n "В телефоне лежит вся неделя."
        n "Удалённые записи."
        n "Системные ошибки."
        n "Отчёт, который от тебя хотели получить."

    if ps_signed_false_report:
        n "И твоя подпись."

    n "На табло твоё имя поднимается на первое место."
    n "Ещё три минуты — и оно останется там."

    menu:
        "Остановить поток и вывести людей":
            $ ps_final_choice = "команда"
            $ ps_humanity += 3
            $ ps_team_unity += 2
            $ ps_integrity += 1
            $ ps_key_choices = ps_key_choices + ["В финале ты выбрал людей, а не рейтинг."]

            p "Останавливаем."
            p "Все отходят от линии."

            cur "Не смей!"

            p "Новичок — правая сторона!"
            p "Ветеран — отключение!"
            p "Шутник — проверь дальний сектор!"

            mem "Впервые рад, что у меня есть настоящее имя."

            n "Ты нажимаешь кнопку."

            if renpy.loadable("audio/door_closed.mp3"):
                play sound "audio/door_closed.mp3"

            n "Поток замирает."
            n "Табло краснеет."
            n "Люди отходят."

        "Взять управление линией и спасти результат":
            $ ps_final_choice = "карьера"
            $ ps_efficiency += 3
            $ ps_endurance += 1
            $ ps_burnout += 2
            $ ps_key_choices = ps_key_choices + ["В финале ты взял управление потоком на себя."]

            p "Ветеран — отключи правую ленту вручную."
            p "Новичок — все ошибки в буфер B-04."
            p "Остальные работают через левую линию."

            sv "Она не выдержит весь поток."

            p "Тогда делим по приоритету."
            p "Тяжёлое в стоп."
            p "Мелкое пропускаем."

            n "На три минуты ты становишься тем, кто решает."
            n "Система молчит."
            n "Люди слушают тебя."

        "Передать журнал нарушений и включить громкую связь" if ps_evidence >= 2:
            $ ps_final_choice = "правда"
            $ ps_integrity += 3
            $ ps_evidence += 1
            $ ps_team_unity += 1
            $ ps_key_choices = ps_key_choices + ["В финале ты сделал нарушения видимыми для всех."]

            p "Куратор, повторите."

            cur "Линию не останавливать."

            p "Записано."

            n "Ты отправляешь журнал на общий экран."
            n "STOP-04."
            n "Сорок семь единиц."
            n "LIFT-09."
            n "Подписи."
            n "Время."

            p "Вот цена этих трёх минут."

            n "Люди перестают работать."
            n "Не по команде."
            n "Просто потому, что теперь все видят одно и то же."

        "Собрать смену голосом" if ps_humor >= 7:
            $ ps_final_choice = "голос"
            $ ps_humor += 3
            $ ps_team_unity += 2
            $ ps_key_choices = ps_key_choices + ["В финале твой голос удержал смену от паники."]

            p "Так."
            p "Система решила взять перерыв."
            p "Мы — нет."

            mem "Это моя реплика."

            p "Авторские права после смены."
            p "Новичок, считай людей."
            p "Ветеран, безопасные ленты."
            p "Остальные — ничего не несём туда, где нас не слышат."

            n "Кто-то смеётся."
            n "Потом повторяет команду."
            n "Голос идёт по складу быстрее рации."

        "Снять жилет и выйти из потока":
            $ ps_final_choice = "уйти"
            $ ps_endurance += 3
            $ ps_integrity += 1
            $ ps_key_choices = ps_key_choices + ["В финале ты выбрал выход и сохранил себя."]

            n "Ты снимаешь жилет."
            n "Кладёшь ТСД на остановившуюся коробку."

            sv "Ты куда?"

            p "Туда, где решение выйти ещё принадлежит мне."

            n "Ты не бежишь."
            n "Не хлопаешь дверью."
            n "Просто выходишь из потока."

    if ps_final_choice in ("карьера", "голос"):
        n "Связь всё ещё не работает."
        n "Последние команды придётся передать вручную."

        $ ps_signal_start()
        call screen ps_signal_challenge
        $ ps_signal_result = _return

        if ps_signal_result[0] == len(ps_signal_sequence) and ps_signal_result[1] == 0:
            $ ps_efficiency += 2
            $ ps_team_unity += 1
            $ ps_unlock_achievement("dispatcher")
            $ ps_key_choices = ps_key_choices + ["Ты без ошибок передал аварийную последовательность."]
            n "Четыре команды уходят в правильном порядке."
            n "Линии освобождаются до того, как система успевает вернуться."
        elif ps_signal_result[0] >= 3:
            $ ps_endurance += 1
            n "Одна команда теряется в шуме."
            n "Но люди переспрашивают."
            n "Последовательность удаётся закончить."
        else:
            $ ps_burnout += 2
            $ ps_team_unity -= 1
            n "Сигналы накладываются друг на друга."
            n "Кто-то останавливается слишком рано."
            n "Кто-то продолжает дольше, чем нужно."
            n "Система возвращается раньше, чем вы успеваете договориться."

    hide sv
    hide vet
    hide newb
    hide mem
    with dissolve

    $ ps_final_ending = ps_ending_id()

    if ps_final_ending == "truth":
        jump ending_truth
    elif ps_final_ending == "people":
        jump ending_people
    elif ps_final_ending == "voice":
        jump ending_voice
    elif ps_final_ending == "leader":
        jump ending_leader
    elif ps_final_ending == "employee":
        jump ending_employee
    elif ps_final_ending == "exit":
        jump ending_exit
    else:
        jump ending_silence


################################################################################
## Финалы
