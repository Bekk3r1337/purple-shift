# -*- coding: utf-8 -*-

label start:
    $ ps_chapter = 1

    scene bg black
    with fade

    centered "Глава 1\nПервая смена"

    pause 1.0

    jump morning_home
label morning_home:

    scene bg black
    with fade
    play music "audio/home_ambient.mp3" fadein 3.0 loop

    n "Будильник не орёт."
    n "Он просто вибрирует где-то рядом."
    n "Как будто боится разбудить что-то лишнее."

    n "Я открываю глаза не сразу."
    n "Сначала просыпается тело."
    n "Потом - мысль, от которой не хочется вставать."

    n "Сегодня смена."

    scene bg room_morning
    with dissolve

    n "Комната выглядит так, будто я в ней только ночую."
    n "Кровать. Стол. Зарядка в розетке."
    n "Ничего лишнего. Как и в голове."

    n "Телефон лежит экраном вниз."
    n "Я и так знаю, что там."
    n "Время. И напоминание, что опаздывать нельзя."

    n "Я переворачиваю его."

    n "06:12."
    n "До выхода - сорок минут."
    n "Этого должно хватить, если не думать."

    n "Я сажусь на край кровати."
    n "Пол холодный."
    n "Почему-то это всегда удивляет."

    n "В какой-то момент ловлю себя на мысли:"
    n "я не злюсь."
    n "И не рад."

    n "Просто иду."

    menu:
        "Подумать: «Ладно. Это просто работа»":
            jump mindset_work

        "Подумать: «Ненадолго. Главное - пережить»":
            jump mindset_survive

        "Отшутиться про себя":
            jump mindset_joke
label mindset_work:
    $ ps_efficiency += 1
    n "Я пожимаю плечами."
    n "Работа как работа."
    n "Не первая и не последняя."
    jump leaving_home

label mindset_survive:
    $ ps_endurance += 1
    n "Главное - не думать дальше сегодняшнего дня."
    n "Сегодняшний я ещё вывезу."
    jump leaving_home

label mindset_joke:
    $ ps_humor += 1
    n "Ну что ж."
    n "Если жизнь - симулятор, то это явно хардкор."
    n "Без обучения."
    jump leaving_home
    
label leaving_home:
    scene bg stairwell
    with dissolve
    stop music fadeout 2.0
    n "Я встаю."
    n "Собираюсь почти на автомате."
    n "Дверь закрывается тихо."
    n "Как будто квартира тоже не хочет меня провожать."
    scene bg street_night
    with fade
    play music "audio/city_night.mp3" fadein 2.0 loop
    n "На улице уже светает."
    n "А внутри - ещё нет."

    scene bg warehouse_outside
    with fade
    stop music fadeout 2.0
    play music "audio/night_shift.mp3" fadein 3.0 loop

    # на всякий случай чистим экран от возможных "хвостов"
    hide sv
    hide vet
    hide mem
    hide newb

    n "Склад видно издалека."

    n "Фиолетовый свет режет глаза даже сквозь веки."
    n "Ты ещё толком не проснулся, а смена уже началась."

    n "За дверью - склад. Внутри - люди в фиолетовой форме."
    n "Тишина, которую перебивает только сканер и короткие команды."

    show sv neutral at ps_right
    with dissolve

    sv "Ты новенький?"
    sv "Сразу вопрос. Без вступлений."
    sv "Ты сюда зачем пришёл?"

    menu:
        "«Деньги здесь и сейчас»":
            jump money
        "«Просто нужна точка опоры»":
            jump anchor
        "Отшутиться":
            jump joke


label money:
    $ ps_efficiency += 1
    n "Ты говоришь это спокойно, будто репетировал."
    sv "Честно. Ладно."
    jump first_mistake

label anchor:
    $ ps_endurance += 1
    n "Слова выходят тяжелее, чем коробки."
    sv "Понял. Тут многие так."
    jump first_mistake

label joke:
    $ ps_humor += 1
    p "Я пришёл за романтикой. Фиолетовый свет - как в клубе."
    sv "..."
    sv "Клуб закончится минут через пять. Когда ТСД умрёт."
    jump first_mistake


label first_mistake:

    n "Тебе выдают ТСД."
    n "Он тёплый, как будто до тебя его уже держали сотни рук."

    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"

    n "Пиип."
    n "Первый скан проходит. Ты почти радуешься."

    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"

    n "Второй скан."
    n "Экран моргает. Секунда. Две."

    # глич-эффект
    scene expression Solid("#ffffff")
    pause 0.05
    scene expression Solid("#000000")
    pause 0.05

    scene bg warehouse_inside
    with fade

    stop music fadeout 2.0
    play music "audio/warehouse_chill.mp3" fadein 2.0 loop

    # сцена сменилась - показываем супервайзера заново
    show sv neutral at ps_right
    with dissolve

    if renpy.loadable("audio/oh-oh.mp3"):
        play sound "audio/oh-oh.mp3"
    n "ТСД пищит резко, как будто обвиняет тебя лично."

    sv "Стоим."
    sv "Покажи."

    n "Ты тянешь ему экран. Пальцы почему-то ватные."

    sv "Ну конечно."
    sv "Классика первой ночи."

    sv "Скан ушёл не туда. Или не ушёл вообще."
    sv "И теперь это будет **висеть**."

    n "Слово «висеть» звучит хуже, чем «ошибка»."

    menu:
        "Сказать честно: «Я не понял, куда нажал»":
            jump mistake_honest
        "Попробовать отшутиться":
            jump mistake_joke
        "Свалить на устройство: «ТСД глючит»":
            jump mistake_tsd

label mistake_honest:
    $ ps_endurance += 1
    $ ps_supervisor_respect += 1
    p "Я не понял, куда нажал..."
    sv "Хорошо."
    sv "Плохая новость: тут некогда понимать."
    sv "Хорошая: сейчас покажу один раз. Второй раз - сам."

    n "Он забирает ТСД, делает пару движений слишком быстро."
    n "Как будто это не техника, а рефлекс."

    sv "Запомнил?"
    menu:
        "Кивнуть":
            jump after_fix
        "Спросить ещё раз, уточнить":
            jump after_fix_brave

label mistake_joke:
    $ ps_humor += 1
    $ ps_supervisor_respect -= 1
    p "Он просто… нервничает. Как и я."
    sv "Очень смешно."
    sv "Здесь шутки стоят времени."
    sv "А время - это деньги. Не твои, правда."

    n "Ты проглатываешь улыбку. Она застревает где-то в горле."
    jump after_fix_cold

label mistake_tsd:
    $ ps_efficiency += 1
    $ ps_supervisor_respect -= 1
    p "ТСД глючит, честно. Он моргнул сам."
    sv "ТСД глючит всегда."
    sv "Разница в том, в чьих он руках."

    n "Он смотрит на тебя так, будто сейчас оценит: сломаешься или останешься."
    jump after_fix_cold

label after_fix:
    n "Супервайзер возвращает ТСД."
    sv "Дальше сам. Линия не ждёт."
    n "Ты делаешь вдох."
    n "Смена не стала легче. Просто стала настоящей."

    # он закончил - убираем, чтобы не висел в потоке
    hide sv
    with dissolve

    jump shift_continues

label after_fix_brave:
    $ ps_endurance += 1
    $ ps_supervisor_respect += 1
    p "Можно ещё раз? Я реально хочу не косячить."
    sv "..."
    sv "Ладно. Уважение за попытку."
    n "Он показывает медленнее. Всё равно быстро."
    sv "Всё. В работу."

    hide sv
    with dissolve

    jump shift_continues

label after_fix_cold:
    n "Супервайзер возвращает ТСД без лишних слов."
    sv "За работу."
    n "И всё. Ни прощения, ни объяснений."
    n "Только склад и твоя ответственность."

    hide sv
    with dissolve

    jump shift_continues


label shift_continues:
    n "Ты встаёшь в поток."
    n "Слева кто-то шепчет: «Главное - не залипнуть на ошибке»."
    n "Справа слышно: «Пиип-пиип-пиип» - как сердцебиение смены."

    n "Склад живёт без тебя."
    n "Но если ты выпадешь - он это заметит."

    # Входит ветеран
    show vet neutral at ps_left
    with dissolve

    n "Рядом в линию становится мужчина постарше. Движения экономные, лицо усталое."
    vet "Первый раз?"
    p "Ага."
    vet "Дыши. Тут главное - дожить до конца смены и не начать ненавидеть воздух."

    # Входит мемный
    show mem grin at ps_center
    with dissolve

    n "С другой стороны появляется парень, который будто бы пришёл сюда не работать, а комментировать жизнь."
    mem "Смена - это как игра."
    mem "Только сохранений нет, а баги платные."

    n "Ты хочешь улыбнуться, но улыбка выходит маленькая."

    # Ритм потока (серия сканов)
    n "Поток начинается."
    n "Коробка. Скан. Переложил."
    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"
    n "Пиип."

    n "Ещё коробка."
    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"
    n "Пиип."

    n "Где-то сзади коротко: «Быстрее!»"
    n "Где-то спереди ещё короче: «Норма!»"

    n "Через пару минут ты ловишь странное чувство."
    n "Будто ты не человек, а конвейер или робот. Руки должны всё успевать."

    # Новичок рядом косячит
    n "Слева от тебя девчонка-новичок путается с коробками."
    n "В её руках дрожит ТСД. На секунду она замирает, будто проваливается из реальности."

    show newb worried at ps_right
    with dissolve

    newb "У меня… не то… кажется…"
    mem "Поздравляю."
    mem "Ты поймала классический квест «ошибка без подсказки»."

    vet "Тише. Пусть человек разберётся."

    n "Ты понимаешь: сейчас будет выбор."
    n "И к чему он приведёт?"

    menu:
        "Помочь новичку (потеряешь темп, но останешься человеком)":
            jump help_newbie
        "Игнорировать и гнать норму (сохранить темп любой ценой)":
            jump grind_norm
        "Уйти на паузу на минуту (собраться и не сломаться)":
            jump take_pause


label help_newbie:
    $ ps_humanity += 2
    $ ps_newbie_trust += 2
    $ ps_key_choices = ps_key_choices + ["Ты потерял темп, чтобы помочь новичку."]
    n "Ты наклоняешься ближе к её экрану."
    p "Покажи. Не дёргайся."
    n "Она показывает. Ошибка простая, но в первый раз это как приговор."

    p "Вот тут. Смотри: сначала это, потом подтверждение."
    n "Ты говоришь максимально спокойно. Даже сам удивляешься."

    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"

    newb "…О! Получилось."
    newb "Спасибо."

    hide newb
    with dissolve

    mem "Вот это да."
    mem "На складе обнаружен редкий лут: человечность."

    vet "Нормально сделал."
    n "Но темп ты потерял. Поток это запомнил."

    jump supervisor_pressure


label grind_norm:
    $ ps_efficiency += 2
    $ ps_humanity -= 1
    $ ps_key_choices = ps_key_choices + ["Ты выбрал норму и не вмешался."]
    # новенькая больше не в фокусе - убираем, чтобы не висела в след. сцене
    hide newb
    with dissolve

    n "Ты делаешь вид, что не слышишь."
    n "Берёшь. Сканируешь. Кладёшь."
    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"
    n "Пиип."

    n "Новичок рядом шепчет что-то себе под нос."
    n "А потом - тихое «блин»."
    n "Ты не поворачиваешься."

    mem "Понимаю."
    mem "Тут или ты добрый, или ты целеустремлённый. Два режима редко совместимы."

    vet "Смотри не перегрейся."
    n "Темп держишь. Но внутри что-то становится чуть суше."

    jump supervisor_pressure


label take_pause:
    $ ps_endurance += 2
    $ ps_key_choices = ps_key_choices + ["Ты позволил себе остановиться и восстановить дыхание."]
    # новенькая не нужна визуально в паузе - прячем
    hide newb
    with dissolve

    n "Ты на секунду выходишь из линии, будто просто поправить перчатку."
    n "Глубокий вдох."
    n "Ещё один."

    n "Шум склада не исчезает."
    n "Но ты перестаёшь тонуть в нём."

    mem "О-о."
    mem "Чел активировал способность «не сломаться»."
    mem "Кулдаун - до следующей смены."

    vet "Нормально. Главное - возвращайся."

    jump supervisor_pressure


label supervisor_pressure:
    n "Ты возвращаешься в ритм."
    n "И ровно в этот момент рядом появляется супервайзер."

    show sv neutral at ps_right
    with dissolve

    sv "Так."
    sv "Смотрю темп."

    n "Он не кричит."
    n "От этого страшнее."

    sv "Ты сейчас либо втягиваешься…"
    sv "…либо начинаешь отставать."
    sv "А отставание тут любят превращать в проблему."

    mem "У нас тут, короче, экономика простая."
    mem "Если ты отстал - значит ты виноват."
    mem "Если не отстал - значит ты мог быстрее."

    sv "Ты кто такой?"
    mem "Я? Я моральная поддержка."
    sv "Понял. Молчи."

    n "На секунду смешно."
    n "Потом снова давит."

    n "Супервайзер уходит так же внезапно, как пришёл."

    hide sv
    with dissolve

    n "И поток продолжает жрать минуты."

    n "Где-то внутри ты отмечаешь: половина смены ещё впереди."
    n "И это звучит как угроза."

    menu:
        "Продолжать (войти в поток глубже)":
            jump mid_shift
        "Оглядеться (заметить детали склада и людей)":
            jump observe


label mid_shift:
    n "Ты перестаёшь считать коробки."
    n "Начинаешь считать вдохи."
    n "Смена превращается в длинный коридор без окон."
    n "И где-то там, впереди…"
    n "должна быть точка, где всё закончится."
    jump toward_end

label observe:
    n "Ты на секунду смотришь по сторонам."
    n "Лица. Движения. Плечи."
    n "Люди как будто держатся на одном - на привычке."
    n "И ты вдруг понимаешь:"
    n "ты тоже начинаешь привыкать."
    jump toward_end


label toward_end:
    n "Склад шумит."
    n "ТСД пищит."
    n "А время ползёт, как коробка по ленте - медленно, но неизбежно."

    n "Дальше будет финальный участок смены."
    n "Самый неприятный."
    n "Там обычно и ломает."

    jump final_stretch


label final_stretch:
    n "Финальный участок смены приходит без предупреждения."
    n "Просто в какой-то момент ты понимаешь: руки уже работают отдельно от головы."

    n "Скан. Переложил."
    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"
    n "Пиип."

    n "Скан. Переложил."
    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"
    n "Пииип."

    n "И вдруг - тишина."
    n "Не на складе. Внутри."
    n "Как будто мозг сказал: «я в отпуск»."

    # ветеран и мемный всё ещё с тобой в кадре
    mem "Эй."
    mem "Если тебя сейчас вырубит - упади красиво."
    mem "Сделай вид, что это катсцена."

    vet "Не слушай его."
    vet "Пей воду. Дыши."
    vet "Смена всегда пытается забрать у тебя главное - внимание."

    n "Ты моргаешь."
    n "Фиолетовый свет в глазах плывёт от усталости."

    # супервайзер возвращается
    show sv neutral at ps_right
    with dissolve

    sv "Так."
    sv "Финишные пятьдесят минут."
    sv "Сейчас обычно и вылезает вся правда."

    n "Он смотрит на линию, потом на тебя."
    sv "Ты как?"

    menu:
        "Сказать честно: «На пределе»":
            jump final_honest
        "Сделать вид, что норм (скрыть)":
            jump final_hide
        "Отшутиться, чтобы не раздавило":
            jump final_joke


label final_honest:
    $ ps_endurance += 1
    $ ps_supervisor_respect += 1
    p "На пределе."
    sv "Понял."
    sv "Не геройствуй."
    sv "Делаешь ровно, без рывков. Лучше медленнее, чем в ошибку."

    vet "Нормально сказал."
    mem "Редкое явление: супервайзер включил человечность."
    mem "Снимайте, это на ТСД."

    n "Тебе становится чуть легче от того, что ты не один в этом моменте."
    jump final_event


label final_hide:
    $ ps_efficiency += 1
    $ ps_endurance -= 1
    p "Нормально."
    sv "Нормально - это когда без косяков."
    sv "Погнали темп."

    n "Ты киваешь."
    n "И понимаешь: теперь ты один на один со своей усталостью."
    mem "О, режим «я железный»."
    mem "Через час узнаем, железный ты или просто греешься."

    jump final_event


label final_joke:
    $ ps_humor += 2
    p "Я в порядке."
    p "Просто морально уже домой вышел."
    sv "Домой выйдешь, когда поток отпустит."
    sv "А поток добрый. Он отпускает всех… когда захочет."

    mem "Супервайзер сейчас выдал философию смены."
    mem "Запишите на стену, рядом с «не бегай по складу»."

    n "Ты смеёшься."
    n "И смех не спасает, но делает воздух чуть менее тяжёлым."
    jump final_event


label final_event:
    n "И вот оно."
    n "Финальный сюрприз."

    n "Рядом кто-то резко дёргает коробку, и она срывается."
    n "Глухой удар."
    n "Потом - второй."
    n "Поток спотыкается."
    hide vet
    with dissolve
    # новенькая снова "в кадре" в момент фейла
    show newb worried at ps_left
    with dissolve

    newb "Я… я не удержала…"

    sv "Стоп."
    sv "Не суетимся."

    n "В этот момент ты понимаешь: сейчас можно либо помочь…"
    n "либо сохранить себя."
    n "И оба варианта - правильные и неправильные одновременно."

    menu:
        "Помочь поднять и восстановить поток (риск, но по-человечески)":
            jump ending_light_path
        "Остаться на своём месте и не лезть (сохранить силы любой ценой)":
            jump ending_hard_path


label ending_light_path:
    $ ps_first_shift_path = "протянул руку"
    $ ps_humanity += 2
    $ ps_newbie_trust += 2
    $ ps_key_choices = ps_key_choices + ["В финале первой смены ты помог восстановить поток."]
    n "Ты делаешь шаг вперёд."
    p "Давай. Вместе."

    n "Вы поднимаете коробки. Руки дрожат, но работают."
    if renpy.loadable("audio/scan_beep.mp3"):
