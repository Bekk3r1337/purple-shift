# -*- coding: utf-8 -*-

label start:
    $ ps_chapter = 1
    $ ps_begin_day(1)

    scene bg black
    with fade

    if ps_player_name in ("Сотрудник", "Employee"):
        $ ps_entered_name = renpy.input(
            _("Как к тебе обращаться?"),
            default=_("Сотрудник"),
            length=18,
        ).strip()
        $ ps_player_name = ps_entered_name or _("Сотрудник")

    call screen ps_day_card(
        1,
        "Первая смена",
        "Новая работа начинается с будильника в 06:12 и сорока минут на сборы."
    )

    jump morning_home
label morning_home:

    scene bg black
    with fade
    $ ps_play_ost("before_shift", fadein=3.0)

    n "Будильник вибрирует где-то под подушкой. Ты находишь телефон не с первого раза и ещё несколько секунд лежишь с закрытыми глазами. Сегодня снова на смену."

    scene bg room_morning
    with dissolve

    n "В комнате только кровать, стол и зарядка у розетки. На экране 06:12. До выхода сорок минут - нормально, если прямо сейчас встать, умыться и не зависнуть с телефоном."

    n "Ты садишься, ставишь ноги на холодный пол и сразу начинаешь считать: десять минут на душ, пять на завтрак, ещё двадцать на дорогу до остановки."

    menu:
        "Подумать: «Ладно. Это просто работа»":
            jump mindset_work

        "Подумать: «Ненадолго. Главное - пережить»":
            jump mindset_survive

        "Отшутиться про себя":
            jump mindset_joke
label mindset_work:
    $ ps_efficiency += 1
    n "Ты пожимаешь плечами. Работа как работа - не первая и, скорее всего, не последняя."
    jump leaving_home

label mindset_survive:
    $ ps_endurance += 1
    n "Главное - не заглядывать дальше сегодняшнего дня. Одну смену ты точно вывезешь, а с остальным разберёшься потом."
    jump leaving_home

label mindset_joke:
    $ ps_humor += 1
    n "Если жизнь действительно симулятор, тебе досталась сложность повыше и почему-то без обучения. Остаётся надеяться, что хотя бы сохранения работают."
    jump leaving_home
    
label leaving_home:
    call ps2_pre_shift(1)

    scene bg stairwell
    with dissolve
    stop music fadeout 2.0
    n "Ты умываешься, натягиваешь одежду и на автомате проверяешь телефон, ключи и пропуск. Дверь закрывается тихо."
    scene bg street_night
    with fade
    $ ps_play_ost("city_night", fadein=2.0)
    n "На улице начинает светать. Автобус почти пустой, и всю дорогу ты стараешься не уснуть."

    scene bg warehouse_outside
    with fade
    stop music fadeout 2.0
    $ ps_play_ost("ordinary_shift", fadein=3.0)

    # на всякий случай чистим экран от возможных "хвостов"
    hide sv
    hide vet
    hide mem
    hide newb

    n "Склад видно ещё с остановки: фиолетовая подсветка, открытые ворота и люди в одинаковой форме у проходной. Внутри шумят ленты, пищат сканеры и кто-то уже раздаёт короткие команды."

    show sv neutral at ps_right
    with dissolve

    sv "Ты новенький? Тогда сразу к делу: зачем пришёл?"

    menu:
        "«Деньги здесь и сейчас»":
            jump money
        "«Просто нужна точка опоры»":
            jump anchor
        "Отшутиться":
            jump joke


label money:
    $ ps_efficiency += 1
    p "Деньги. Мне сейчас без них никак."
    sv "Честно. Ладно."
    jump first_mistake

label anchor:
    $ ps_endurance += 1
    p "Нужна работа, за которую платят вовремя. Хочу хоть за что-то зацепиться."
    sv "Понял. Тут многие так."
    jump first_mistake

label joke:
    $ ps_humor += 1
    p "Я пришёл за романтикой. Фиолетовый свет - как в клубе."
    sv "..."
    sv "Клуб закончится минут через пять. Когда ТСД умрёт."
    jump first_mistake


label first_mistake:

    n "Тебе выдают ТСД. Корпус ещё тёплый после прошлого сотрудника."

    $ ps_play_sfx("scan_ok")

    n "Пиип."
    n "Первый скан проходит. Ты почти радуешься."

    $ ps_play_sfx("scan_ok")

    n "Второй скан. Экран моргает. Секунда. Две."

    # глич-эффект
    if persistent.ps_reduce_flashes:
        scene expression Solid("#3b2945")
        pause 0.10
    else:
        scene expression Solid("#ffffff")
        pause 0.05
        scene expression Solid("#000000")
        pause 0.05

    scene bg warehouse_inside
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("cold_line", fadein=2.0)

    # сцена сменилась - показываем супервайзера заново
    show sv neutral at ps_right
    with dissolve

    $ ps_play_sfx("scan_error")
    n "ТСД резко пищит - так, что ты сразу чувствуешь себя виноватым."

    sv "Стоим. Покажи."

    n "Ты тянешь ему экран. Пальцы почему-то ватные."

    sv "Ну конечно. Классика первой ночи."

    sv "Скан ушёл не туда. Или не ушёл вообще. Теперь заказ будет {b}висеть{/b}, пока мы не найдём его вручную."

    n "Он говорит без крика, но ты уже представляешь, как вся линия ждёт из-за одного нажатия."

    menu:
        "Сказать честно: «Я не понял, куда нажал»":
            jump mistake_honest
        "Попробовать отшутиться":
            jump mistake_joke
        "Свалить на устройство: «ТСД глючит»":
            jump mistake_tsd

label mistake_honest:
    $ ps_endurance += 1
    $ ps_supervisor_respect += 1
    p "Я не понял, куда нажал..."
    sv "Хорошо. Плохая новость: тут некогда понимать. Хорошая: сейчас покажу один раз. Второй раз - сам."

    n "Он забирает ТСД и за пару секунд пробегает по меню. Пальцы двигаются быстрее, чем ты успеваешь следить."

    sv "Запомнил?"
    menu:
        "Кивнуть":
            jump after_fix
        "Спросить ещё раз, уточнить":
            jump after_fix_brave

label mistake_joke:
    $ ps_humor += 1
    $ ps_supervisor_respect -= 1
    p "Он просто… нервничает. Как и я."
    sv "Очень смешно. Здесь шутки стоят времени. А время - это деньги. Не твои, правда."

    n "Ты проглатываешь улыбку. Она застревает где-то в горле."
    jump after_fix_cold

label mistake_tsd:
    $ ps_efficiency += 1
    $ ps_supervisor_respect -= 1
    p "ТСД глючит, честно. Он моргнул сам."
    sv "ТСД глючит всегда. Разница в том, в чьих он руках."

    n "Он внимательно смотрит на тебя, прикидывая: сломаешься или останешься."
    jump after_fix_cold

label after_fix:
    n "Супервайзер возвращает ТСД."
    sv "Дальше сам. Линия не ждёт."
    n "Ты снова берёшь ТСД. Теперь хотя бы понятно, где открывать проблемный поток."

    # он закончил - убираем, чтобы не висел в потоке
    hide sv
    with dissolve

    jump shift_continues

label after_fix_brave:
    $ ps_endurance += 1
    $ ps_supervisor_respect += 1
    p "Можно ещё раз? Я реально хочу не косячить."
    sv "..."
    sv "Ладно. Уважение за попытку."
    n "Он показывает медленнее. Всё равно быстро."
    sv "Всё. В работу."

    hide sv
    with dissolve

    jump shift_continues

label after_fix_cold:
    n "Супервайзер возвращает ТСД без лишних слов."
    sv "За работу."
    n "На этом разговор закончен. Разбираться с ошибкой дальше придётся самому."

    hide sv
    with dissolve

    jump shift_continues


label shift_continues:
    n "Ты встаёшь в поток. Слева кто-то шепчет: «Главное - не залипнуть на ошибке». Справа без остановки пищат чужие сканеры."

    n "Лента не замедляется, пока ты пытаешься встроиться. Стоит задержаться у одной коробки - перед тобой сразу вырастает очередь."

    # Входит ветеран
    show vet neutral at ps_left
    with dissolve

    n "Рядом в линию становится мужчина постарше. Движения экономные, лицо усталое."
    vet "Первый раз?"
    p "Ага."
    vet "Дыши ровнее. Зажмёшь плечи - через час руки отвалятся. Остальное потом."

    # Входит мемный
    show mem grin at ps_center
    with dissolve

    n "С другой стороны пристраивается парень примерно твоего возраста. Он успевает взять коробку, отсканировать её и вставить комментарий раньше, чем ты поворачиваешь голову."
    mem "Смена - это как игра. Только сохранений нет, а баги платные."

    n "Ты хочешь улыбнуться, но улыбка выходит маленькая."

    # Ритм потока (серия сканов)
    n "Поток начинается. Коробка. Скан. Переложил."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "Ещё коробка."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "Где-то сзади коротко: «Быстрее!» Где-то спереди ещё короче: «Норма!»"

    n "Через пару минут движения сливаются с конвейером. Руки сами хватают, сканируют, откладывают; ты только пытаешься не отстать."

    # Новичок рядом косячит
    n "Слева от тебя девчонка-новичок путается с коробками. В её руках дрожит ТСД. На секунду она замирает и выпадает из общего ритма."

    show newb worried at ps_right
    with dissolve

    newb "У меня… не то… кажется…"
    mem "Поздравляю. Ты поймала классический квест «ошибка без подсказки»."

    vet "Тише. Пусть человек разберётся."

    menu:
        "Подойти и помочь разобраться":
            jump help_newbie
        "Не отвлекаться от своей нормы":
            jump grind_norm
        "Выйти из линии на минуту и перевести дух":
            jump take_pause


label help_newbie:
    $ ps_humanity += 2
    $ ps_newbie_trust += 2
    $ ps_key_choices = ps_key_choices + ["Ты потерял темп, чтобы помочь новичку."]
    n "Ты наклоняешься ближе к её экрану."
    p "Покажи. Не дёргайся."
    n "Она показывает экран. Ошибка простая, но Лера смотрит на красную строку и боится нажать ещё хоть что-нибудь."

    p "Вот тут. Смотри: сначала это, потом подтверждение."
    n "Ты сам только что путался в этом меню, поэтому показываешь медленно и дважды повторяешь порядок."

    $ ps_play_sfx("scan_ok")

    newb "…О! Получилось. Спасибо."

    hide newb
    with dissolve

    mem "О, редкий дроп: помощь коллеге. Всё, молчу."

    vet "Нормально сделал."
    n "За это время перед твоим местом успела вырасти очередь."

    jump supervisor_pressure


label grind_norm:
    $ ps_efficiency += 2
    $ ps_humanity -= 1
    $ ps_key_choices = ps_key_choices + ["Ты выбрал норму и не вмешался."]
    # новенькая больше не в фокусе - убираем, чтобы не висела в след. сцене
    hide newb
    with dissolve

    n "Ты делаешь вид, что не слышишь. Берёшь. Сканируешь. Кладёшь."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "Новичок рядом шепчет что-то себе под нос. А потом - тихое «блин». Ты не поворачиваешься."

    mem "Без осуждения. Я в первый день тоже выбрал коробки. Они хотя бы помощи не просили."

    vet "Смотри не перегрейся."
    n "Темп держится. Слева Лера всё ещё возится с ошибкой, и смотреть туда становится неловко."

    jump supervisor_pressure


label take_pause:
    $ ps_endurance += 2
    $ ps_key_choices = ps_key_choices + ["Ты позволил себе остановиться и восстановить дыхание."]
    # новенькая не нужна визуально в паузе - прячем
    hide newb
    with dissolve

    n "Ты на секунду выходишь из линии под предлогом поправить перчатку. Глубокий вдох. Ещё один."

    n "После двух глубоких вдохов пальцы перестают дрожать."

    mem "Пауза без разрешения? Смело. Запиши мне потом этот билд."

    vet "Нормально. Главное - возвращайся."

    jump supervisor_pressure


label supervisor_pressure:
    n "Ты возвращаешься в ритм. И ровно в этот момент рядом появляется супервайзер."

    show sv neutral at ps_right
    with dissolve

    sv "Так. Смотрю темп."

    n "Он молча смотрит на счётчик в твоём ТСД. Ждать замечания оказывается хуже, чем услышать его сразу."

    sv "Либо втягиваешься, либо начинаешь отставать. А отставание здесь быстро делают твоей личной проблемой."

    mem "Экономика простая: отстал - виноват. Успел - мог быстрее. Удобно, да?"

    sv "Ты кто такой?"
    mem "Я? Я моральная поддержка."
    sv "Понял. Молчи."

    n "Макс усмехается, а Артём уже идёт проверять следующий участок."

    hide sv
    with dissolve

    n "Очередь на экране снова растёт. До конца смены ещё несколько часов."

    menu:
        "Сосредоточиться на своей линии":
            jump mid_shift
        "Оглядеться по сторонам":
            jump observe


label mid_shift:
    n "Ты перестаёшь считать коробки и следишь только за дыханием. Время дробится на короткие серии между ошибками и новыми стопками."
    jump toward_end

label observe:
    n "Ты на секунду смотришь по сторонам. Уставшие лица, одни и те же движения, поднятые плечи. У тебя уже получается почти так же."
    jump toward_end


label toward_end:
    n "ТСД пищит, лента гудит. На часах проходит всего несколько минут."

    n "До конца остаётся меньше часа, и на линию как раз подают новую партию."

    jump final_stretch


label final_stretch:
    n "Пальцы хватают следующую коробку раньше, чем ты успеваешь прочитать маркировку."

    n "Скан. Переложил."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "Скан. Переложил."
    $ ps_play_sfx("scan_ok")
    n "Пииип."

    n "В какой-то момент ты пропускаешь знакомый сигнал и несколько секунд смотришь на коробку, не понимая, куда её класть."

    # ветеран и мемный всё ещё с тобой в кадре
    mem "Эй. Если тебя сейчас вырубит - упади красиво. Сделай вид, что это катсцена."

    vet "Не слушай его. Воды выпей и не спеши, пока в глазах плывёт."

    n "Ты моргаешь. Фиолетовый свет в глазах плывёт от усталости."

    # супервайзер возвращается
    show sv neutral at ps_right
    with dissolve

    sv "До конца пятьдесят минут. Сейчас главное - без рывков."

    n "Он смотрит на линию, потом на тебя."
    sv "Ты как?"

    menu:
        "Сказать честно: «На пределе»":
            jump final_honest
        "Сказать, что всё нормально":
            jump final_hide
        "Отшутиться":
            jump final_joke


label final_honest:
    $ ps_endurance += 1
    $ ps_supervisor_respect += 1
    p "На пределе."
    sv "Понял. Не геройствуй. Делаешь ровно, без рывков. Лучше медленнее, чем в ошибку."

    vet "Нормально сказал."
    mem "Редкое явление: супервайзер включил человечность. Снимайте, это на ТСД."

    n "Можно немного сбавить темп, и никто не требует объяснений. От этого сразу легче дышать."
    jump final_event


label final_hide:
    $ ps_efficiency += 1
    $ ps_endurance -= 1
    p "Нормально."
    sv "Нормально - это когда без косяков. Погнали темп."

    n "Ты киваешь и снова берёшь коробку. Усталость никуда не делась, просто теперь о ней никто не знает."
    mem "О, режим «я железный». Через час узнаем, железный ты или просто греешься."

    jump final_event


label final_joke:
    $ ps_humor += 2
    p "Я в порядке. Просто морально уже домой вышел."
    sv "Домой выйдешь, когда я отпущу. Пока держи свой участок."

    mem "Вот теперь узнаю начальство. А я уже испугался, что он нас пожалел."

    n "Смеяться трудно, но на пару секунд напряжение отпускает."
    jump final_event


label final_event:
    call ps2_shift_event(1)
    call ps2_storm_echo(1)

    n "Рядом кто-то резко дёргает коробку, и она срывается. Глухой удар. Потом - второй. Поток спотыкается."
    hide vet
    with dissolve
    # новенькая снова "в кадре" в момент фейла
    show newb worried at ps_left
    with dissolve

    newb "Я… я не удержала…"

    sv "Стоп. Не суетимся."

    menu:
        "Подойти и помочь поднять коробки":
            jump ending_light_path
        "Остаться на своём месте":
            jump ending_hard_path


label ending_light_path:
    $ ps_first_shift_path = "протянул руку"
    $ ps_humanity += 2
    $ ps_newbie_trust += 2
    $ ps_key_choices = ps_key_choices + ["В финале первой смены ты помог восстановить поток."]
    n "Ты делаешь шаг вперёд."
    p "Давай. Вместе."

    n "Вы поднимаете коробки. Руки дрожат, но работают."
    $ ps_play_sfx("scan_ok")

    mem "Так, эту серию назовём «коробки наносят ответный удар»."

    sv "Нормально. Быстро закрыли."

    newb "Спасибо… правда."
    vet "Сначала люди, потом лента. Иначе завтра некому будет вставать в поток."

    # новенькую можно убрать после благодарности
    hide newb
    hide sv
    hide vet
    hide mem
    with dissolve
    n "Ты возвращаешься в линию. Руки дрожат, зато Лера уже снова сканирует рядом."

    n "Через несколько минут объявляют конец смены. Лента замедляется, сканеры один за другим замолкают."

    sv "Всё. Снялись."

    mem "Поздравляю. Ты прошёл туториал. Дальше начинается игра."
    scene bg warehouse_outside
    with fade
    n "На улице холодный воздух быстро приводит тебя в чувство. По дороге к проходной ты ловишь себя на мысли, что завтра всё-таки вернёшься."



    call screen ps_shift_report(
        "Итоги первой смены",
        "Ты выжил в потоке и не прошёл мимо чужой ошибки."
    )

    jump chapter2_after_shift



label ending_hard_path:
    $ ps_first_shift_path = "сохранил силы"
    $ ps_endurance += 2
    $ ps_key_choices = ps_key_choices + ["В финале первой смены ты выбрал сохранить себя."]
    n "Ты остаёшься на месте. Ноги уже дрожат, и до конца смены ещё нужно простоять."

    n "Кто-то поднимает коробки без тебя. Ты слышишь шуршание, тяжёлые вдохи, короткие команды."

    mem "Нормальный выбор. Сначала выжить, потом спасать мир."

    sv "Ладно. Дальше. Темп не теряем."

    # новенькая больше не нужна в кадре
    hide newb
    with dissolve

    n "Ты снова в потоке. Скан. Переложил."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "Падение коробок остаётся за спиной. Через минуту ты уже почти не слышишь, как Лера извиняется."

    n "Команда о конце смены застаёт тебя с очередной коробкой в руках."

    sv "Всё. Снялись."

    mem "Поздравляю. Ты выжил. Это, кстати, главный навык."
    show vet neutral at ps_left
    with dissolve
    vet "Домой придёшь - поешь и выспись. График сразу не открывай."
    hide vet
    with dissolve
    
    n "На улице холодно. Пока идёшь к остановке, снова слышишь в голове писк сканера и понимаешь: ты уже начал привыкать."

    stop music fadeout 2.0

    hide sv
    hide vet
    hide mem
    hide newb
    with dissolve

    call screen ps_shift_report(
        "Итоги первой смены",
        "Ты сохранил силы. Иногда выживание - тоже честный выбор."
    )

    jump chapter2_after_shift
    
label chapter2_after_shift:
    scene bg warehouse_inside
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("after_shift", fadein=3.0)

    n "Лента замедляется, и Артём отправляет людей в раздевалку. Пальцы ещё повторяют движение сканера, пока ты убираешь ТСД."

    n "Ты выходишь из линии. Никто не останавливает. Это и есть знак, что можно идти домой."

    # Ветеран рядом - спокойно, без давления
    show vet neutral at ps_left
    with dissolve

    vet "Ну что. Первая есть."

    n "Виктор снимает перчатки и по очереди разминает пальцы."

    menu:
        "Спросить: «С каждым разом легче?»":
            jump after_shift_ask
        "Кивнуть и промолчать":
            jump after_shift_silent


label after_shift_ask:
    $ ps_endurance += 1
    p "С каждым разом легче?"

    vet "Нет. Потом просто заранее знаешь, где заболит и когда лучше попить воды."

    n "Он отвечает ровно, даже не пытаясь тебя приободрить."

    jump after_shift_continue


label after_shift_silent:
    $ ps_endurance += 1
    n "Ты киваешь. На разговор сейчас сил нет."

    vet "Нормально. После первой смены ещё долго в голове пищит."

    jump after_shift_continue


label after_shift_continue:

    hide vet
    with dissolve
    scene bg locker_room
    with fade
    n "В раздевалке пахнет потом и стиральным порошком. Все переодеваются молча."

    # Мемный появляется - контраст
    show mem grin at ps_center
    with dissolve

    mem "Поздравляю. Ты официально пережил первый уровень."

    mem "Дальше будет веселее. Или нет. Я пока не разобрался."

    menu:
        "Ответить шуткой":
            jump after_shift_joke
        "Сказать честно: «Я выжат»":
            jump after_shift_honest
        "Сказать: «Нормально»":
            jump after_shift_mask


label after_shift_joke:
    $ ps_humor += 1
    p "А сохранение было?"

    mem "Было. Но его перезаписали чужой ошибкой."

    n "Ты коротко улыбаешься."

    jump after_shift_exit


label after_shift_honest:
    $ ps_endurance += 1
    p "Если честно - я выжат."

    mem "Тоже. Я уже минуту пытаюсь застегнуть пустой шкафчик."

    jump after_shift_exit


label after_shift_mask:
    $ ps_efficiency += 1
    p "Нормально."

    mem "Ты так говоришь, когда хочешь закончить разговор. Ладно, не лезу."
    jump after_shift_exit


label after_shift_exit:

    hide mem
    with dissolve

    n "Ты выходишь из раздевалки. Фиолетовый свет у проходной кажется тусклее, чем в начале смены."
    scene bg street_night
    with fade
    n "Снаружи стало холоднее. И тише."

    n "У турникета телефон показывает следующую смену. Ты задерживаешь взгляд на кнопке отмены."

    # Крючок главы
    menu:
        "Идти домой молча":
            jump chapter2_home
        "Задержаться на минуту и осмотреться":
            jump chapter2_observe

   
label chapter2_home:

    scene bg street_night
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("walk_to_shift", fadein=3.0)

    n "Двери склада остаются позади. Ты идёшь к остановке почти автоматически, разминая затёкшие пальцы."

    n "Стоит где-то вдалеке пискнуть машине, и плечи снова напрягаются."

    n "Город ночью другой. Не добрее. Просто тише."

    n "Улица молчит, зато в голове продолжается смена."
    n "Пиип."
    n "Пиип."
    n "Пиип."

    n "Ты моргаешь - и на секунду кажется, что над головой опять лампы склада. Но это просто фонарь."

    menu:
        "Проверить телефон":
            jump chapter2_home_phone
        "Не трогать телефон. Просто идти":
            jump chapter2_home_keep


label chapter2_home_phone:
    $ ps_efficiency += 1
    n "Телефон вибрирует в кармане. Среди сообщений уже висит график на следующую смену."

    menu:
        "Разозлиться":
            jump chapter2_home_angry
        "Принять как факт":
            jump chapter2_home_accept


label chapter2_home_keep:
    $ ps_endurance += 1
    n "Ты не достаёшь телефон: на это тоже нужны силы, а их не осталось."

    n "Пусть хотя бы эти десять минут будут без цифр. Без норм. Без «почему так медленно»."

    jump chapter2_home_end


label chapter2_home_angry:
    $ ps_endurance += 1
    n "Внутри поднимается злость от простой мысли: для системы ты всего лишь строчка в расписании."

    n "Ты сжимаешь телефон, замечаешь это и убираешь его в карман."

    jump chapter2_home_end


label chapter2_home_accept:
    $ ps_efficiency += 1
    n "Ты проверяешь время начала, закрываешь приложение и прикидываешь, когда ставить будильник. От того, как быстро это получается, становится не по себе."

    jump chapter2_home_end


label chapter2_home_end:
    n "Ты идёшь дальше. Витрины закрыты. Окна тёмные. Редкие машины шуршат по мокрому асфальту."

    n "Пальцы пахнут пластиком и картоном. Ты трёшь их друг о друга и решаешь дома сразу пойти к раковине."

    n "До подъезда остаётся один квартал. Мысль возвращается сама: ты уже начал привыкать."
    jump chapter2_night_home

label chapter2_observe:

    scene bg warehouse_outside
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("after_shift", fadein=2.5)

    n "Ты задерживаешься у выхода, чтобы спокойно отдышаться перед дорогой. Одна лампа в фиолетовой вывеске мигает через раз."

    n "На парковке тихо, только за стеной всё ещё ровно гудит склад."

    n "Ты слышишь ровные, спокойные шаги."

    show mem grin at ps_center
    with dissolve

    mem "Тоже завис? Это нормально. После первой смены мозг ещё какое-то время не понимает, что всё - можно."

    n "Он смотрит туда же. Привычная улыбка пропала, и теперь видно, насколько Макс устал."

    menu:
        "Спросить: «Ты давно здесь?»":
            jump chapter2_observe_ask
        "Сказать: «Не хочу привыкнуть»":
            jump chapter2_observe_fear
        "Промолчать":
            jump chapter2_observe_silent


label chapter2_observe_ask:
    $ ps_humanity += 1
    p "Ты давно здесь?"

    mem "Да не знаю. Давно. Половине бардака уже не удивляюсь, а на вторую половину всё ещё злюсь."

    mem "Наверное, поэтому и не ушёл."

    jump chapter2_observe_continue


label chapter2_observe_fear:
    $ ps_endurance += 1
    p "Я не хочу привыкнуть."

    mem "Привыкание приходит без уведомлений. Однажды поймаешь себя на слове «нормально» - вот и всё."

    n "Ты вспоминаешь, как недавно сам сказал это в раздевалке."
    jump chapter2_observe_continue


label chapter2_observe_silent:
    $ ps_endurance += 1
    n "Ты молчишь. Макс ждёт ответа, потом кивает."

    mem "Ладно, понял. Не буду вытягивать."

    jump chapter2_observe_continue


label chapter2_observe_continue:

    n "Из дверей выходит девушка-новичок. Та самая. Она держит куртку в руках и явно не понимает, что делать дальше."

    show newb worried at ps_right
    with dissolve

    newb "Вы… вы уже уходите?"

    mem "Я - да. А он… он думает."

    n "Она сначала смотрит на Макса, потом на тебя, но уходить не спешит."

    menu:
        "Сказать ей что-то поддерживающее":
            jump chapter2_observe_support
        "Сказать нейтрально: «Пора домой»":
            jump chapter2_observe_neutral


label chapter2_observe_support:
    $ ps_humanity += 2
    $ ps_newbie_trust += 2
    $ ps_key_choices = ps_key_choices + ["После смены ты поддержал новичка."]
    p "Первый раз всегда самый шумный. Но ты справилась."

    newb "Я там чуть не расплакалась. Потом получилось, и вроде отпустило."

    mem "Ну вот. Ещё один человек пережил обучение без инструкции."

    n "Её улыбка едва заметна - на большее сил не осталось."

    jump chapter2_observe_end


label chapter2_observe_neutral:
    $ ps_efficiency += 1
    p "Пора домой. Завтра снова."

    newb "Да… завтра… Страшно, что завтра уже стоит в графике."

    mem "Добро пожаловать. Тут завтра всегда стоит заранее."

    n "Она кивает, но за курткой не тянется. Похоже, ждала другого ответа."

    jump chapter2_observe_end


label chapter2_observe_end:
    hide mem
    hide newb
    with dissolve

    n "У проходной вы коротко прощаетесь и расходитесь к разным остановкам."

    stop music fadeout 2.0

    jump chapter2_night_home
    
label chapter2_night_home:

    scene black
    with fade

    centered "День первый\nПосле смены"

    pause 1.2

    scene bg room_night
    with fade

    stop music fadeout 2.0
    $ ps_play_ost("before_shift", fadein=3.0)

    n "Дома тепло и непривычно тихо."

    n "Ты снимаешь обувь, ставишь телефон на стол и ловишь себя на простой мысли: если не смотреть в приложение, может, ничего и не было."

    n "Плечи ноют, пальцы всё ещё чувствуют края картона. В голове продолжают сменяться номера ячеек."

    n "Ты подходишь к раковине. Шум воды впервые за день не требует от тебя никакого действия."

    menu:
        "Долго отмывать руки после смены":
            jump chapter2_night_wash
        "Не мыть. Просто лечь":
            jump chapter2_night_skip_wash


label chapter2_night_wash:
    $ ps_endurance += 1

    n "Ты моешь руки, пока вода не становится прохладной. Запах картона исчезает, но пальцы всё ещё напряжены."

    jump chapter2_night_phone


label chapter2_night_skip_wash:
    $ ps_endurance += 1

    n "Ты проходишь мимо раковины и садишься на край кровати. Пальцы трутся друг о друга, продолжая по памяти перебирать коробки."

    jump chapter2_night_phone


label chapter2_night_phone:

    n "Телефон лежит на столе экраном вниз. Каждая вибрация напоминает, что график никуда не делся."

    menu:
        "Проверить график на завтра":
            jump chapter2_night_schedule
        "Не смотреть. Сделать вид, что завтра не существует":
            jump chapter2_night_denial


label chapter2_night_schedule:
    $ ps_efficiency += 1

    n "Ты переворачиваешь телефон. Приложение так и осталось открыто на графике: завтра снова смена. Ты машинально прикидываешь время будильника и чувствуешь, как возвращается раздражение."

    n "В голове появляется мысль:"
    n "«Я уже не выбираю. Я только подтверждаю.»"

    jump chapter2_night_end


label chapter2_night_denial:
    $ ps_endurance += 1

    n "Ты не берёшь телефон. Сдвигаешь его чуть дальше, как опасный предмет."

    n "Ты знаешь - завтра всё равно наступит. Но следующие десять минут хочешь потратить на себя, без графиков и норм."

    n "Без шума склада наконец слышно собственный вопрос: чего ты сам хочешь от этой работы?"

    jump chapter2_night_end


label chapter2_night_end:

    scene bg room_night
    with dissolve

    n "Ты долго ворочаешься. Перед сном успеваешь подумать: «Я справлюсь». И следом: «А если это и есть то самое привыкание?»"

    call ps2_after_shift(1)

    stop music fadeout 2.0

    jump chapter2_hook
