# -*- coding: utf-8 -*-

label start:
    $ ps_chapter = 1
    $ ps_begin_day(1)

    scene bg black
    with fade

    if ps_player_name == "Сотрудник":
        $ ps_entered_name = renpy.input(
            "Как к тебе обращаться?",
            default="Сотрудник",
            length=18,
        ).strip()
        $ ps_player_name = ps_entered_name or "Сотрудник"

    call screen ps_day_card(
        1,
        "Первая смена",
        "Обычный рабочий день начинается до того, как ты успеваешь к нему подготовиться."
    )

    jump morning_home
label morning_home:

    scene bg black
    with fade
    play music "audio/home_ambient.mp3" fadein 3.0 loop

    n "Будильник не орёт. Он просто вибрирует где-то рядом. Как будто боится разбудить что-то лишнее."

    n "Глаза открываются не сразу: сначала просыпается тело, а уже потом приходит мысль, ради которой совсем не хочется вставать."

    n "Сегодня смена."

    scene bg room_morning
    with dissolve

    n "Комната выглядит так, будто ты в ней только ночуешь: кровать, стол и зарядка в розетке. Ничего лишнего — ни вокруг, ни в голове."

    n "Телефон лежит экраном вниз. Ты и без него знаешь, что там: время и напоминание, что опаздывать нельзя."

    n "Ты всё-таки переворачиваешь его."

    n "06:12. До выхода — сорок минут. Этого должно хватить, если не зависнуть на краю кровати."

    n "Ты садишься на край кровати и ставишь ноги на холодный пол. Почему-то он каждый раз оказывается холоднее, чем помнилось."

    n "В какой-то момент ты ловишь себя на простой мысли: злости нет, радости тоже."

    n "Ты просто идёшь."

    menu:
        "Подумать: «Ладно. Это просто работа»":
            jump mindset_work

        "Подумать: «Ненадолго. Главное - пережить»":
            jump mindset_survive

        "Отшутиться про себя":
            jump mindset_joke
label mindset_work:
    $ ps_efficiency += 1
    n "Ты пожимаешь плечами. Работа как работа — не первая и, скорее всего, не последняя."
    jump leaving_home

label mindset_survive:
    $ ps_endurance += 1
    n "Главное — не заглядывать дальше сегодняшнего дня. Одну смену ты точно вывезешь, а с остальным разберёшься потом."
    jump leaving_home

label mindset_joke:
    $ ps_humor += 1
    n "Если жизнь действительно симулятор, тебе досталась сложность повыше и почему-то без обучения. Остаётся надеяться, что хотя бы сохранения работают."
    jump leaving_home
    
label leaving_home:
    call ps2_pre_shift(1)

    scene bg stairwell
    with dissolve
    stop music fadeout 2.0
    n "Ты встаёшь и собираешься почти на автомате. Дверь закрывается тихо, будто квартира тоже не хочет тебя провожать."
    scene bg street_night
    with fade
    play music "audio/city_night.mp3" fadein 2.0 loop
    n "На улице уже светает, но внутри до утра ещё далеко."

    scene bg warehouse_outside
    with fade
    stop music fadeout 2.0
    play music "audio/night_shift.mp3" fadein 3.0 loop

    # на всякий случай чистим экран от возможных "хвостов"
    hide sv
    hide vet
    hide mem
    hide newb

    n "Склад видно издалека."

    n "Фиолетовый свет режет глаза даже сквозь веки. Ты ещё толком не проснулся, а смена уже началась."

    n "За дверью - склад. Внутри - люди в фиолетовой форме. Тишина, которую перебивает только сканер и короткие команды."

    show sv neutral at ps_right
    with dissolve

    sv "Ты новенький? Сразу вопрос. Без вступлений. Ты сюда зачем пришёл?"

    menu:
        "«Деньги здесь и сейчас»":
            jump money
        "«Просто нужна точка опоры»":
            jump anchor
        "Отшутиться":
            jump joke


label money:
    $ ps_efficiency += 1
    n "Ты говоришь это спокойно, будто репетировал."
    sv "Честно. Ладно."
    jump first_mistake

label anchor:
    $ ps_endurance += 1
    n "Слова выходят тяжелее, чем коробки."
    sv "Понял. Тут многие так."
    jump first_mistake

label joke:
    $ ps_humor += 1
    p "Я пришёл за романтикой. Фиолетовый свет - как в клубе."
    sv "..."
    sv "Клуб закончится минут через пять. Когда ТСД умрёт."
    jump first_mistake


label first_mistake:

    n "Тебе выдают ТСД. Он тёплый, как будто до тебя его уже держали сотни рук."

    $ ps_play_sfx("scan_ok")

    n "Пиип."
    n "Первый скан проходит. Ты почти радуешься."

    $ ps_play_sfx("scan_ok")

    n "Второй скан. Экран моргает. Секунда. Две."

    # глич-эффект
    if persistent.ps_reduce_flashes:
        scene expression Solid("#3b2945")
        pause 0.10
    else:
        scene expression Solid("#ffffff")
        pause 0.05
        scene expression Solid("#000000")
        pause 0.05

    scene bg warehouse_inside
    with fade

    stop music fadeout 2.0
    play music "audio/warehouse_chill.mp3" fadein 2.0 loop

    # сцена сменилась - показываем супервайзера заново
    show sv neutral at ps_right
    with dissolve

    $ ps_play_sfx("scan_error")
    n "ТСД пищит резко, как будто обвиняет тебя лично."

    sv "Стоим. Покажи."

    n "Ты тянешь ему экран. Пальцы почему-то ватные."

    sv "Ну конечно. Классика первой ночи."

    sv "Скан ушёл не туда. Или не ушёл вообще. И теперь это будет **висеть**."

    n "Слово «висеть» звучит хуже, чем «ошибка»."

    menu:
        "Сказать честно: «Я не понял, куда нажал»":
            jump mistake_honest
        "Попробовать отшутиться":
            jump mistake_joke
        "Свалить на устройство: «ТСД глючит»":
            jump mistake_tsd

label mistake_honest:
    $ ps_endurance += 1
    $ ps_supervisor_respect += 1
    p "Я не понял, куда нажал..."
    sv "Хорошо. Плохая новость: тут некогда понимать. Хорошая: сейчас покажу один раз. Второй раз - сам."

    n "Он забирает ТСД, делает пару движений слишком быстро. Как будто это не техника, а рефлекс."

    sv "Запомнил?"
    menu:
        "Кивнуть":
            jump after_fix
        "Спросить ещё раз, уточнить":
            jump after_fix_brave

label mistake_joke:
    $ ps_humor += 1
    $ ps_supervisor_respect -= 1
    p "Он просто… нервничает. Как и я."
    sv "Очень смешно. Здесь шутки стоят времени. А время - это деньги. Не твои, правда."

    n "Ты проглатываешь улыбку. Она застревает где-то в горле."
    jump after_fix_cold

label mistake_tsd:
    $ ps_efficiency += 1
    $ ps_supervisor_respect -= 1
    p "ТСД глючит, честно. Он моргнул сам."
    sv "ТСД глючит всегда. Разница в том, в чьих он руках."

    n "Он смотрит на тебя так, будто прикидывает: сломаешься или останешься."
    jump after_fix_cold

label after_fix:
    n "Супервайзер возвращает ТСД."
    sv "Дальше сам. Линия не ждёт."
    n "Ты делаешь вдох. Смена не стала легче. Просто стала настоящей."

    # он закончил - убираем, чтобы не висел в потоке
    hide sv
    with dissolve

    jump shift_continues

label after_fix_brave:
    $ ps_endurance += 1
    $ ps_supervisor_respect += 1
    p "Можно ещё раз? Я реально хочу не косячить."
    sv "..."
    sv "Ладно. Уважение за попытку."
    n "Он показывает медленнее. Всё равно быстро."
    sv "Всё. В работу."

    hide sv
    with dissolve

    jump shift_continues

label after_fix_cold:
    n "Супервайзер возвращает ТСД без лишних слов."
    sv "За работу."
    n "И всё. Ни прощения, ни объяснений. Только склад и твоя ответственность."

    hide sv
    with dissolve

    jump shift_continues


label shift_continues:
    n "Ты встаёшь в поток. Слева кто-то шепчет: «Главное - не залипнуть на ошибке». Справа слышно: «Пиип-пиип-пиип» - как сердцебиение смены."

    n "Склад живёт без тебя. Но если ты выпадешь - он это заметит."

    # Входит ветеран
    show vet neutral at ps_left
    with dissolve

    n "Рядом в линию становится мужчина постарше. Движения экономные, лицо усталое."
    vet "Первый раз?"
    p "Ага."
    vet "Дыши. Тут главное - дожить до конца смены и не начать ненавидеть воздух."

    # Входит мемный
    show mem grin at ps_center
    with dissolve

    n "С другой стороны появляется парень, который будто бы пришёл сюда не работать, а комментировать жизнь."
    mem "Смена - это как игра. Только сохранений нет, а баги платные."

    n "Ты хочешь улыбнуться, но улыбка выходит маленькая."

    # Ритм потока (серия сканов)
    n "Поток начинается. Коробка. Скан. Переложил."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "Ещё коробка."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "Где-то сзади коротко: «Быстрее!» Где-то спереди ещё короче: «Норма!»"

    n "Через пару минут ты ловишь странное чувство. Будто ты не человек, а конвейер или робот. Руки должны всё успевать."

    # Новичок рядом косячит
    n "Слева от тебя девчонка-новичок путается с коробками. В её руках дрожит ТСД. На секунду она замирает, будто проваливается из реальности."

    show newb worried at ps_right
    with dissolve

    newb "У меня… не то… кажется…"
    mem "Поздравляю. Ты поймала классический квест «ошибка без подсказки»."

    vet "Тише. Пусть человек разберётся."

    n "Ты понимаешь: сейчас будет выбор. И к чему он приведёт?"

    menu:
        "Помочь новичку (потеряешь темп, но останешься человеком)":
            jump help_newbie
        "Игнорировать и гнать норму (сохранить темп любой ценой)":
            jump grind_norm
        "Уйти на паузу на минуту (собраться и не сломаться)":
            jump take_pause


label help_newbie:
    $ ps_humanity += 2
    $ ps_newbie_trust += 2
    $ ps_key_choices = ps_key_choices + ["Ты потерял темп, чтобы помочь новичку."]
    n "Ты наклоняешься ближе к её экрану."
    p "Покажи. Не дёргайся."
    n "Она показывает. Ошибка простая, но в первый раз это как приговор."

    p "Вот тут. Смотри: сначала это, потом подтверждение."
    n "Ты говоришь максимально спокойно. Даже сам удивляешься."

    $ ps_play_sfx("scan_ok")

    newb "…О! Получилось. Спасибо."

    hide newb
    with dissolve

    mem "Вот это да. На складе обнаружен редкий лут: человечность."

    vet "Нормально сделал."
    n "Но темп ты потерял. Поток это запомнил."

    jump supervisor_pressure


label grind_norm:
    $ ps_efficiency += 2
    $ ps_humanity -= 1
    $ ps_key_choices = ps_key_choices + ["Ты выбрал норму и не вмешался."]
    # новенькая больше не в фокусе - убираем, чтобы не висела в след. сцене
    hide newb
    with dissolve

    n "Ты делаешь вид, что не слышишь. Берёшь. Сканируешь. Кладёшь."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "Новичок рядом шепчет что-то себе под нос. А потом - тихое «блин». Ты не поворачиваешься."

    mem "Понимаю. Тут или ты добрый, или ты целеустремлённый. Два режима редко совместимы."

    vet "Смотри не перегрейся."
    n "Темп держишь. Но внутри что-то становится чуть суше."

    jump supervisor_pressure


label take_pause:
    $ ps_endurance += 2
    $ ps_key_choices = ps_key_choices + ["Ты позволил себе остановиться и восстановить дыхание."]
    # новенькая не нужна визуально в паузе - прячем
    hide newb
    with dissolve

    n "Ты на секунду выходишь из линии, будто просто поправить перчатку. Глубокий вдох. Ещё один."

    n "Шум склада не исчезает. Но ты перестаёшь тонуть в нём."

    mem "О-о. Чел активировал способность «не сломаться». Кулдаун - до следующей смены."

    vet "Нормально. Главное - возвращайся."

    jump supervisor_pressure


label supervisor_pressure:
    n "Ты возвращаешься в ритм. И ровно в этот момент рядом появляется супервайзер."

    show sv neutral at ps_right
    with dissolve

    sv "Так. Смотрю темп."

    n "Он не кричит. От этого страшнее."

    sv "Ты сейчас либо втягиваешься… …либо начинаешь отставать. А отставание тут любят превращать в проблему."

    mem "У нас тут, короче, экономика простая. Если ты отстал - значит ты виноват. Если не отстал - значит ты мог быстрее."

    sv "Ты кто такой?"
    mem "Я? Я моральная поддержка."
    sv "Понял. Молчи."

    n "На секунду смешно. Потом снова давит."

    n "Супервайзер уходит так же внезапно, как пришёл."

    hide sv
    with dissolve

    n "И поток продолжает жрать минуты."

    n "Где-то внутри ты отмечаешь: половина смены ещё впереди. И это звучит как угроза."

    menu:
        "Продолжать (войти в поток глубже)":
            jump mid_shift
        "Оглядеться (заметить детали склада и людей)":
            jump observe


label mid_shift:
    n "Ты перестаёшь считать коробки. Начинаешь считать вдохи. Смена превращается в длинный коридор без окон."
    n "И где-то там, впереди… должна быть точка, где всё закончится."
    jump toward_end

label observe:
    n "Ты на секунду смотришь по сторонам. Лица. Движения. Плечи. Люди как будто держатся на одном - на привычке."
    n "И ты вдруг понимаешь:"
    n "ты тоже начинаешь привыкать."
    jump toward_end


label toward_end:
    n "Склад шумит. ТСД пищит. А время ползёт, как коробка по ленте - медленно, но неизбежно."

    n "Дальше будет финальный участок смены. Самый неприятный. Там обычно и ломает."

    jump final_stretch


label final_stretch:
    n "Финальный участок смены приходит без предупреждения. Просто в какой-то момент ты понимаешь: руки уже работают отдельно от головы."

    n "Скан. Переложил."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "Скан. Переложил."
    $ ps_play_sfx("scan_ok")
    n "Пииип."

    n "И вдруг - тишина. Не на складе. Внутри. Как будто мозг сказал: «я в отпуск»."

    # ветеран и мемный всё ещё с тобой в кадре
    mem "Эй. Если тебя сейчас вырубит - упади красиво. Сделай вид, что это катсцена."

    vet "Не слушай его. Пей воду. Дыши. Смена всегда пытается забрать у тебя главное - внимание."

    n "Ты моргаешь. Фиолетовый свет в глазах плывёт от усталости."

    # супервайзер возвращается
    show sv neutral at ps_right
    with dissolve

    sv "Так. Финишные пятьдесят минут. Сейчас обычно и вылезает вся правда."

    n "Он смотрит на линию, потом на тебя."
    sv "Ты как?"

    menu:
        "Сказать честно: «На пределе»":
            jump final_honest
        "Сделать вид, что норм (скрыть)":
            jump final_hide
        "Отшутиться, чтобы не раздавило":
            jump final_joke


label final_honest:
    $ ps_endurance += 1
    $ ps_supervisor_respect += 1
    p "На пределе."
    sv "Понял. Не геройствуй. Делаешь ровно, без рывков. Лучше медленнее, чем в ошибку."

    vet "Нормально сказал."
    mem "Редкое явление: супервайзер включил человечность. Снимайте, это на ТСД."

    n "Тебе становится чуть легче от того, что ты не один в этом моменте."
    jump final_event


label final_hide:
    $ ps_efficiency += 1
    $ ps_endurance -= 1
    p "Нормально."
    sv "Нормально - это когда без косяков. Погнали темп."

    n "Ты киваешь. И понимаешь: теперь ты один на один со своей усталостью."
    mem "О, режим «я железный». Через час узнаем, железный ты или просто греешься."

    jump final_event


label final_joke:
    $ ps_humor += 2
    p "Я в порядке. Просто морально уже домой вышел."
    sv "Домой выйдешь, когда поток отпустит. А поток добрый. Он отпускает всех… когда захочет."

    mem "Супервайзер сейчас выдал философию смены. Запишите на стену, рядом с «не бегай по складу»."

    n "Ты смеёшься. И смех не спасает, но делает воздух чуть менее тяжёлым."
    jump final_event


label final_event:
    call ps2_shift_event(1)
    call ps2_storm_echo(1)

    n "И вот оно. Финальный сюрприз."

    n "Рядом кто-то резко дёргает коробку, и она срывается. Глухой удар. Потом - второй."
    n "Поток спотыкается."
    hide vet
    with dissolve
    # новенькая снова "в кадре" в момент фейла
    show newb worried at ps_left
    with dissolve

    newb "Я… я не удержала…"

    sv "Стоп. Не суетимся."

    n "В этот момент ты понимаешь: сейчас можно либо помочь… либо сохранить себя. И оба варианта - правильные и неправильные одновременно."

    menu:
        "Помочь поднять и восстановить поток (риск, но по-человечески)":
            jump ending_light_path
        "Остаться на своём месте и не лезть (сохранить силы любой ценой)":
            jump ending_hard_path


label ending_light_path:
    $ ps_first_shift_path = "протянул руку"
    $ ps_humanity += 2
    $ ps_newbie_trust += 2
    $ ps_key_choices = ps_key_choices + ["В финале первой смены ты помог восстановить поток."]
    n "Ты делаешь шаг вперёд."
    p "Давай. Вместе."

    n "Вы поднимаете коробки. Руки дрожат, но работают."
    $ ps_play_sfx("scan_ok")

    mem "Опа. Сюжетный поворот: командная работа. Это точно склад? А не эпичная анимешная сцена?"

    sv "Нормально. Быстро закрыли."

    newb "Спасибо… правда."
    vet "Запомни: смена заканчивается. А поток остаётся. Лучше пусть останется уважение."

    # новенькую можно убрать после благодарности
    hide newb
    hide sv
    hide vet
    hide mem
    with dissolve
    n "Ты возвращаешься в линию. Сил почти нет. Но внутри почему-то тепло."

    n "Фиолетовый свет уже не режет. Он просто есть."

    n "Конец смены приходит тихо. Как будто склад не хочет признавать, что отпускает тебя."

    sv "Всё. Снялись."

    mem "Поздравляю. Ты прошёл туториал. Дальше начинается игра."
    scene bg warehouse_outside
    with fade
    n "Ты выходишь наружу. Холодный воздух - как новая жизнь."

    n "И впервые за ночь ты думаешь:"
    n "«Я ещё вернусь. Но уже другим»."



    call screen ps_shift_report(
        "Итоги первой смены",
        "Ты выжил в потоке и не прошёл мимо чужой ошибки."
    )

    jump chapter2_after_shift



label ending_hard_path:
    $ ps_first_shift_path = "сохранил силы"
    $ ps_endurance += 2
    $ ps_key_choices = ps_key_choices + ["В финале первой смены ты выбрал сохранить себя."]
    n "Ты остаёшься на месте. Потому что если сделаешь шаг - можешь рассыпаться."

    n "Кто-то поднимает коробки без тебя. Ты слышишь шуршание, тяжёлые вдохи, короткие команды."

    mem "Нормальный выбор. Сначала выжить, потом спасать мир."

    sv "Ладно. Дальше. Темп не теряем."

    # новенькая больше не нужна в кадре
    hide newb
    with dissolve

    n "Ты снова в потоке. Скан. Переложил."
    $ ps_play_sfx("scan_ok")
    n "Пиип."

    n "И ты замечаешь, что внутри стало тише. Не спокойнее. Тише."

    n "Смена заканчивается резко. Как выключили звук."

    sv "Всё. Снялись."

    mem "Поздравляю. Ты выжил. Это, кстати, главный навык."
    show vet neutral at ps_left
    with dissolve
    vet "Не теряй себя. Это самое лёгкое тут - потерять."
    hide vet
    with dissolve
    
    n "Ты выходишь наружу. Холодный воздух бьёт в лицо и не даёт соврать."

    n "Ты идёшь домой. И ловишь мысль, от которой становится не по себе:"
    n "«Я уже привыкаю»."

    stop music fadeout 2.0

    hide sv
    hide vet
    hide mem
    hide newb
    with dissolve

    call screen ps_shift_report(
        "Итоги первой смены",
        "Ты сохранил силы. Иногда выживание — тоже честный выбор."
    )

    jump chapter2_after_shift
    
label chapter2_after_shift:
    scene bg warehouse_inside
    with fade

    stop music fadeout 2.0
    play music "audio/after_shift_ambient.mp3" fadein 3.0 loop

    n "Смена заканчивается не хлопком двери. Она просто… перестаёт требовать внимания."

    n "Руки всё ещё помнят ритм. Голова - уже нет."

    n "Ты выходишь из линии. Никто не останавливает. Это и есть знак, что можно идти домой."

    # Ветеран рядом - спокойно, без давления
    show vet neutral at ps_left
    with dissolve

    vet "Ну что. Первая есть."

    n "Он говорит это так, будто речь не о смене. А о чём-то, что ты теперь носишь с собой."

    menu:
        "Спросить: «С каждым разом легче?»":
            jump after_shift_ask
        "Кивнуть и промолчать":
            jump after_shift_silent


label after_shift_ask:
    $ ps_endurance += 1
    p "С каждым разом легче?"

    vet "Нет."
    vet "Просто по-другому."

    vet "Ты либо привыкаешь. Либо учишься замечать, где именно тебя это ломает."

    n "Ответ не утешает. Но почему-то честный."

    jump after_shift_continue


label after_shift_silent:
    $ ps_endurance += 1
    n "Ты киваешь. Слова сейчас тяжелее, чем коробки."

    vet "Это нормально. Первый раз - всегда шумный внутри."

    jump after_shift_continue


label after_shift_continue:

    hide vet
    with dissolve
    scene bg locker_room
    with fade
    n "В раздевалке пахнет потом, порошком и тишиной. Люди переодеваются молча. Как будто разговоры остались на складе."

    # Мемный появляется - контраст
    show mem grin at ps_center
    with dissolve

    mem "Поздравляю. Ты официально пережил первый уровень."

    mem "Дальше будет веселее. Или нет. Я пока не разобрался."

    menu:
        "Ответить шуткой":
            jump after_shift_joke
        "Сказать честно: «Я выжат»":
            jump after_shift_honest
        "Сказать: «Нормально»":
            jump after_shift_mask


label after_shift_joke:
    $ ps_humor += 1
    p "А сохранение было?"

    mem "Было. Но его перезаписали чужой ошибкой."

    n "Ты коротко улыбаешься."

    jump after_shift_exit


label after_shift_honest:
    $ ps_endurance += 1
    p "Если честно - я выжат."

    mem "Ага. Значит, ещё живой."

    mem "Когда станет всё равно - вот тогда начинай переживать."

    jump after_shift_exit


label after_shift_mask:
    $ ps_efficiency += 1
    p "Нормально."

    mem "Опасное слово. Обычно его говорят, когда не хотят разбираться."

    n "Ты это запоминаешь."
    jump after_shift_exit


label after_shift_exit:

    hide mem
    with dissolve

    n "Ты покидаешь раздевалку. Фиолетовый свет уже не давит. Он просто сопровождает."
    scene bg street_night
    with fade
    n "Снаружи стало холоднее. И тише."

    n "А внутри появился вопрос: «Вернусь ли я завтра?»"

    # Крючок главы
    menu:
        "Идти домой молча":
            jump chapter2_home
        "Задержаться на минуту и осмотреться":
            jump chapter2_observe

   
label chapter2_home:

    scene bg street_night
    with fade

    stop music fadeout 2.0
    play music "audio/night_walk.mp3" fadein 3.0 loop

    n "Двери склада остаются позади. Холодный воздух бьёт в лицо и не даёт соврать."

    n "Ноги идут сами. Как будто у них есть маршрут, а у тебя - только усталость."

    n "Фиолетовый свет остаётся где-то позади. Но ощущение склада не уходит. Оно прилипает к рукам, к плечам, к мыслям."

    n "Город ночью другой. Не добрее. Просто тише."

    n "Ты ловишь себя на том, что слушаешь не улицу. А внутренний шум."
    n "Пиип."
    n "Пиип."
    n "Пиип."

    n "Ты моргаешь - и на секунду кажется, что над головой опять лампы склада. Но это просто фонарь."

    menu:
        "Проверить телефон":
            jump chapter2_home_phone
        "Не трогать телефон. Просто идти":
            jump chapter2_home_keep


label chapter2_home_phone:
    $ ps_efficiency += 1
    n "Телефон вибрирует ещё до того, как ты его достаёшь. Будто он тоже всё знал."

    n "Сообщения. Уведомления. И самое неприятное - график."

    n "Следующая смена уже стоит. Система не ждёт твоего согласия."

    menu:
        "Разозлиться":
            jump chapter2_home_angry
        "Принять как факт":
            jump chapter2_home_accept


label chapter2_home_keep:
    $ ps_endurance += 1
    n "Ты не достаёшь телефон. Не потому что сильный. Потому что сил нет."

    n "Пусть хотя бы эти десять минут будут без цифр. Без норм. Без «почему так медленно»."

    jump chapter2_home_end


label chapter2_home_angry:
    $ ps_endurance += 1
    n "Внутри поднимается злость. Не на склад. Не на людей."
    n "На то, что ты - всего лишь строчка в расписании."

    n "Ты сжимаешь телефон сильнее, чем нужно. Потом отпускаешь. Потому что даже злость - это энергия."
    n "А у тебя её мало."

    jump chapter2_home_end


label chapter2_home_accept:
    $ ps_efficiency += 1
    n "Ты смотришь на график как на погоду. Дождь. Холод."
    n "Смена."

    n "Не споришь. Не радуешься. Просто фиксируешь."

    n "И от этого становится чуть страшнее. Потому что привыкание всегда начинается тихо."

    jump chapter2_home_end


label chapter2_home_end:
    n "Ты идёшь дальше. Витрины закрыты. Окна тёмные."
    n "Редкие машины шуршат по мокрому асфальту."

    n "Пальцы пахнут пластиком и коробками. Хочется помыть руки. Но ты понимаешь: это не про грязь."

    n "Это про чувство, которое не смывается водой."

    n "Где-то впереди - подъезд. Дома будет тепло. И тишина."

    n "И ты снова поймаешь эту мысль:"
    n "«Я уже привыкаю…»"
    jump chapter2_night_home

label chapter2_observe:

    scene bg warehouse_outside
    with fade

    stop music fadeout 2.0
    play music "audio/after_shift_ambient.mp3" fadein 2.5 loop

    n "Ты не уходишь сразу. Стоишь у выхода, будто ждёшь, что склад скажет что-то ещё."

    n "Фиолетовая линия на крыше мерцает. Как будто это не подсветка. А пульс."

    n "Ночь принимает склад спокойно. Склад принимает ночь ещё спокойнее."

    n "Ты слышишь шаги. Не быстрые. Не нервные."

    show mem grin at ps_center
    with dissolve

    mem "Тоже завис? Это нормально. После первой смены мозг ещё какое-то время не понимает, что всё - можно."

    n "Он смотрит туда же, куда и ты. И впервые выглядит не шутником, а просто усталым."

    menu:
        "Спросить: «Ты давно здесь?»":
            jump chapter2_observe_ask
        "Сказать: «Не хочу привыкнуть»":
            jump chapter2_observe_fear
        "Промолчать":
            jump chapter2_observe_silent


label chapter2_observe_ask:
    $ ps_humanity += 1
    p "Ты давно здесь?"

    mem "Достаточно, чтобы перестать удивляться. И недостаточно, чтобы перестать злиться."

    mem "Смешной баланс. Держит в тонусе."

    jump chapter2_observe_continue


label chapter2_observe_fear:
    $ ps_endurance += 1
    p "Я не хочу привыкнуть."

    mem "Понимаю. Только знаешь, что самое подлое?"

    mem "Ты не заметишь момент, когда привык. Просто однажды скажешь «нормально» - и сам поверишь."

    n "Эти слова цепляются."
    jump chapter2_observe_continue


label chapter2_observe_silent:
    $ ps_endurance += 1
    n "Ты молчишь. И почему-то это честнее всего."

    mem "Окей. Иногда молчание - единственное, что не врёт."

    jump chapter2_observe_continue


label chapter2_observe_continue:

    n "Из дверей выходит девушка-новичок. Та самая. Она держит куртку в руках, как будто забыла, как её надевать."

    show newb worried at ps_right
    with dissolve

    newb "Вы… вы уже уходите?"

    mem "Я - да. А он… он думает."

    n "Она смотрит на тебя. Как будто сейчас решит, безопасно ли тут быть человеком."

    menu:
        "Сказать ей что-то поддерживающее":
            jump chapter2_observe_support
        "Сказать нейтрально: «Пора домой»":
            jump chapter2_observe_neutral


label chapter2_observe_support:
    $ ps_humanity += 2
    $ ps_newbie_trust += 2
    $ ps_key_choices = ps_key_choices + ["После смены ты поддержал новичка."]
    p "Первый раз всегда самый шумный. Но ты справилась."

    newb "Я… почти расплакалась там. Но потом… как-то… отпустило."

    mem "Видишь? Ещё один человек узнал, что можно не умереть."

    n "Она немного улыбается. Как будто экономит эмоции."

    jump chapter2_observe_end


label chapter2_observe_neutral:
    $ ps_efficiency += 1
    p "Пора домой. Завтра снова."

    newb "Да… завтра… Страшно, что завтра уже стоит в графике."

    mem "Добро пожаловать. Тут завтра всегда стоит заранее."

    n "Она кивает. И ты видишь: ей хотелось, чтобы кто-то сказал, что это ненормально. Но никто не сказал."

    jump chapter2_observe_end


label chapter2_observe_end:
    hide mem
    hide newb
    with dissolve

    n "Вы расходитесь. Каждый - в свою тишину."

    n "Склад остаётся позади. Но ты понимаешь: он уже где-то внутри."

    stop music fadeout 2.0

    jump chapter2_night_home
    
label chapter2_night_home:

    scene black
    with fade

    centered "День первый\nПосле смены"

    pause 1.2

    scene bg room_night
    with fade

    stop music fadeout 2.0
    play music "audio/home_ambient.mp3" fadein 3.0 loop

    n "Дома тепло. И от этого становится не легче — просто тише."

    n "Ты снимаешь обувь. Ставишь телефон на стол. И на секунду ловишь себя на мысли:"
    n "если не смотреть в приложение — будто ничего и не было."

    n "Но тело не верит. Плечи помнят нагрузку. Пальцы — гофры и картон."
    n "А голова всё ещё работает в режиме потока."

    n "Ты подходишь к раковине. Вода шумит ровно. Слишком спокойно, чтобы быть правдой."

    menu:
        "Тщательно мыть руки, будто смываешь смену":
            jump chapter2_night_wash
        "Не мыть. Просто лечь":
            jump chapter2_night_skip_wash


label chapter2_night_wash:
    $ ps_endurance += 1

    n "Ты моешь руки долго. Слишком долго."

    n "Пена пахнет приятно. Но ощущения не меняет. Будто ты пытаешься смыть не грязь."
    n "А рабочий день."

    n "В какой-то момент ты понимаешь:"
    n "смывается только усталость. А привычка останется."

    jump chapter2_night_phone


label chapter2_night_skip_wash:
    $ ps_endurance += 1

    n "Ты проходишь мимо раковины. Садишься на край кровати."

    n "Пальцы всё равно трутся друг о друга. Как будто продолжают работать. Как будто им не дали команду «стоп»."

    n "Ты вздыхаешь. И понимаешь: тишина — тоже нагрузка. Просто другая."

    jump chapter2_night_phone


label chapter2_night_phone:

    n "Телефон лежит на столе экраном вниз. Обычно дома телефон — это отдых. Сегодня — это продолжение смены."

    menu:
        "Проверить график на завтра":
            jump chapter2_night_schedule
        "Не смотреть. Сделать вид, что завтра не существует":
            jump chapter2_night_denial


label chapter2_night_schedule:
    $ ps_efficiency += 1

    n "Ты переворачиваешь телефон."

    n "График открыт слишком быстро. Будто он и не закрывался."

    n "Завтра стоит. Как факт. Как погода. Как штраф, который приходит без причины."

    n "Ты ловишь пустое раздражение. Не злость. Просто… тяжесть."

    n "В голове появляется мысль:"
    n "«Я уже не выбираю. Я только подтверждаю.»"

    jump chapter2_night_end


label chapter2_night_denial:
    $ ps_endurance += 1

    n "Ты не берёшь телефон. Сдвигаешь его чуть дальше, как опасный предмет."

    n "Ты знаешь — завтра всё равно наступит. Но тебе нужно хотя бы десять минут побыть человеком, а не системой."

    n "Тишина заполняет комнату. И в этой тишине слышно то, что днём не слышно."

    n "Собственный вопрос. Не про деньги. Не про нормы."
    n "Про тебя."

    jump chapter2_night_end


label chapter2_night_end:

    scene bg room_night
    with dissolve

    n "Ты ложишься. Потолок смотрит в ответ. Сон приходит медленно, будто тоже устал."

    n "Перед тем как выключиться, ты думаешь:"
    n "«Я справлюсь.» И сразу — второй мыслью:"
    n "«А если это и есть то самое привыкание?»"

    call ps2_after_shift(1)

    stop music fadeout 2.0

    jump chapter2_hook
