    mem "Опа."
    mem "Сюжетный поворот: командная работа."
    mem "Это точно склад? А не эпичная анимешная сцена?"

    sv "Нормально."
    sv "Быстро закрыли."

    newb "Спасибо… правда."
    vet "Запомни: смена заканчивается. А поток остаётся."
    vet "Лучше пусть останется уважение."

    # новенькую можно убрать после благодарности
    hide newb
    hide sv
    hide vet
    hide mem
    with dissolve
    n "Ты возвращаешься в линию."
    n "Сил почти нет."
    n "Но внутри почему-то тепло."

    n "Фиолетовый свет уже не режет."
    n "Он просто есть."

    n "Конец смены приходит тихо."
    n "Как будто склад не хочет признавать, что отпускает тебя."

    sv "Всё. Снялись."

    mem "Поздравляю."
    mem "Ты прошёл туториал."
    mem "Дальше начинается игра."
    scene bg warehouse_outside
    with fade
    n "Ты выходишь наружу."
    n "Холодный воздух - как новая жизнь."

    n "И впервые за ночь ты думаешь:"
    n "«Я ещё вернусь. Но уже другим»."



    call screen ps_shift_report(
        "Итоги первой смены",
        "Ты выжил в потоке и не прошёл мимо чужой ошибки."
    )

    jump chapter2_after_shift



label ending_hard_path:
    $ ps_first_shift_path = "сохранил силы"
    $ ps_endurance += 2
    $ ps_key_choices = ps_key_choices + ["В финале первой смены ты выбрал сохранить себя."]
    n "Ты остаёшься на месте."
    n "Потому что если сделаешь шаг - можешь рассыпаться."

    n "Кто-то поднимает коробки без тебя."
    n "Ты слышишь шуршание, тяжёлые вдохи, короткие команды."

    mem "Нормальный выбор."
    mem "Сначала выжить, потом спасать мир."

    sv "Ладно. Дальше."
    sv "Темп не теряем."

    # новенькая больше не нужна в кадре
    hide newb
    with dissolve

    n "Ты снова в потоке."
    n "Скан. Переложил."
    if renpy.loadable("audio/scan_beep.mp3"):
        play sound "audio/scan_beep.mp3"
    n "Пиип."

    n "И ты замечаешь, что внутри стало тише."
    n "Не спокойнее."
    n "Тише."

    n "Смена заканчивается резко."
    n "Как выключили звук."

    sv "Всё. Снялись."

    mem "Поздравляю."
    mem "Ты выжил."
    mem "Это, кстати, главный навык."
    show vet neutral at ps_left
    with dissolve
    vet "Не теряй себя."
    vet "Это самое лёгкое тут - потерять."
    hide vet
    with dissolve
    
    n "Ты выходишь наружу."
    n "Холодный воздух бьёт в лицо и не даёт соврать."

    n "Ты идёшь домой."
    n "И ловишь мысль, от которой становится не по себе:"
    n "«Я уже привыкаю»."

    stop music fadeout 2.0

    hide sv
    hide vet
    hide mem
    hide newb
    with dissolve

    call screen ps_shift_report(
        "Итоги первой смены",
        "Ты сохранил силы. Иногда выживание — тоже честный выбор."
    )

    jump chapter2_after_shift
    
label chapter2_after_shift:
    $ ps_chapter = 2

    scene bg warehouse_inside
    with fade

    stop music fadeout 2.0
    play music "audio/after_shift_ambient.mp3" fadein 3.0 loop

    n "Смена заканчивается не хлопком двери."
    n "Она просто… перестаёт требовать внимания."

    n "Руки всё ещё помнят ритм."
    n "Голова - уже нет."

    n "Ты выходишь из линии."
    n "Никто не останавливает."
    n "Это и есть знак, что можно идти домой."

    # Ветеран рядом - спокойно, без давления
    show vet neutral at ps_left
    with dissolve

    vet "Ну что."
    vet "Первая есть."

    n "Он говорит это так, будто речь не о смене."
    n "А о чём-то, что ты теперь носишь с собой."

    menu:
        "Спросить: «С каждым разом легче?»":
            jump after_shift_ask
        "Кивнуть и промолчать":
            jump after_shift_silent


label after_shift_ask:
    $ ps_endurance += 1
    p "С каждым разом легче?"

    vet "Нет."
    vet "Просто по-другому."

    vet "Ты либо привыкаешь."
    vet "Либо учишься замечать, где именно тебя это ломает."

    n "Ответ не утешает."
    n "Но почему-то честный."

    jump after_shift_continue


label after_shift_silent:
    $ ps_endurance += 1
    n "Ты киваешь."
    n "Слова сейчас тяжелее, чем коробки."

    vet "Это нормально."
    vet "Первый раз - всегда шумный внутри."

    jump after_shift_continue


label after_shift_continue:

    hide vet
    with dissolve
    scene bg locker_room
    with fade
    n "В раздевалке пахнет потом, порошком и тишиной."
    n "Люди переодеваются молча."
    n "Как будто разговоры остались на складе."

    # Мемный появляется - контраст
    show mem grin at ps_center
    with dissolve

    mem "Поздравляю."
    mem "Ты официально пережил первый уровень."

    mem "Дальше будет веселее."
    mem "Или нет. Я пока не разобрался."

    menu:
        "Ответить шуткой":
            jump after_shift_joke
        "Сказать честно: «Я выжат»":
            jump after_shift_honest
        "Сказать: «Нормально»":
            jump after_shift_mask


label after_shift_joke:
    $ ps_humor += 1
    p "А сохранение было?"

    mem "Было."
    mem "Но его перезаписали чужой ошибкой."

    n "Ты коротко улыбаешься."

    jump after_shift_exit


label after_shift_honest:
    $ ps_endurance += 1
    p "Если честно - я выжат."

    mem "Ага."
    mem "Значит, ещё живой."

    mem "Когда станет всё равно - вот тогда начинай переживать."

